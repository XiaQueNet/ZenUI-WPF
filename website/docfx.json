{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/ZenUI.Wpf/ZenUI.Wpf.csproj",
            "src/ZenUI.Wpf.Converters/ZenUI.Wpf.Converters.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "Configuration": "Release",
        "TargetFramework": "net8.0-windows"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "src": "../assets/brand",
        "dest": "images/brand",
        "files": [
          "zenui-icon.png",
          "zenui-logo.png"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "ZenUI.Wpf",
      "_appTitle": "ZenUI 文档",
      "_appFooter": "© 2026 MNORG · ZenUI is released under the MIT License.",
      "_appLogoPath": "images/brand/zenui-icon.png",
      "_appFaviconPath": "images/brand/zenui-icon.png",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_gitContribute": {
        "repo": "https://github.com/XiaQueNet/ZenUI-WPF",
        "branch": "main"
      }
    },
    "sitemap": {
      "baseUrl": "https://zenui.mnorg.cn/",
      "priority": 0.5,
      "changefreq": "weekly"
    }
  }
}

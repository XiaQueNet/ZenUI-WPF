<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net471;net472;net5.0-windows;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>

    <RootNamespace>ZenUI.Wpf.Converters</RootNamespace>
    <AssemblyName>ZenUI.Wpf.Converters</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>true</IsPackable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.9</VersionSuffix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <PackageId>ZenUI.Wpf.Converters</PackageId>
    <Title>ZenUI WPF 转换器</Title>
    <Authors>XiaQueNet</Authors>
    <Description>面向 .NET Framework 4.6.2 及以上版本与现代 .NET WPF 应用的可复用值转换器库。</Description>
    <PackageTags>wpf;converters;binding;ui;net462;net471;net472;net5;net8;windows</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>zenui-icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>发布详情请参阅包内的 CHANGELOG.md。</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/XiaQueNet/ZenUI-WPF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/XiaQueNet/ZenUI-WPF.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\brand\zenui-icon.png" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 按钮 -->
    <sys:Double x:Key="ZenButtonMinHeight">36</sys:Double>
    <Thickness x:Key="ZenButtonPadding">10,4</Thickness>
    <CornerRadius x:Key="ZenButtonCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ZenButtonFocusVisualCornerRadius">13</CornerRadius>

    <!-- 列表框 -->
    <Thickness x:Key="ZenListBoxPadding">4</Thickness>
    <CornerRadius x:Key="ZenListBoxCornerRadius">8</CornerRadius>
    <Thickness x:Key="ZenListBoxItemPadding">12,9</Thickness>
    <Thickness x:Key="ZenListBoxItemMargin">0,1</Thickness>
    <CornerRadius x:Key="ZenListBoxItemCornerRadius">5</CornerRadius>

    <!-- 滚动条 -->
    <sys:Double x:Key="ZenScrollBarThickness">12</sys:Double>
    <sys:Double x:Key="ZenScrollBarTrackThickness">6</sys:Double>
    <sys:Double x:Key="ZenScrollBarThumbMinLength">32</sys:Double>
    <Thickness x:Key="ZenVerticalScrollBarMargin">0,4</Thickness>
    <Thickness x:Key="ZenHorizontalScrollBarMargin">4,0</Thickness>
    <Thickness x:Key="ZenVerticalScrollBarTrackMargin">0,0,1,0</Thickness>
    <Thickness x:Key="ZenHorizontalScrollBarTrackMargin">0,0,0,1</Thickness>
    <Thickness x:Key="ZenVerticalScrollBarThumbMargin">5,0,1,0</Thickness>
    <Thickness x:Key="ZenHorizontalScrollBarThumbMargin">0,5,0,1</Thickness>
    <CornerRadius x:Key="ZenScrollBarCornerRadius">3</CornerRadius>

    <!-- 弹层表面 -->
    <Thickness x:Key="ZenComboBoxPopupMargin">0,4,0,0</Thickness>
    <Thickness x:Key="ZenComboBoxPopupPadding">4</Thickness>
    <CornerRadius x:Key="ZenComboBoxPopupCornerRadius">6</CornerRadius>

    <!-- 右键菜单 -->
    <sys:Double x:Key="ZenContextMenuMinWidth">184</sys:Double>
    <Thickness x:Key="ZenContextMenuPadding">5</Thickness>
    <CornerRadius x:Key="ZenContextMenuCornerRadius">8</CornerRadius>
    <sys:Double x:Key="ZenContextMenuItemMinHeight">36</sys:Double>
    <Thickness x:Key="ZenContextMenuItemPadding">8,4</Thickness>
    <CornerRadius x:Key="ZenContextMenuItemCornerRadius">5</CornerRadius>
    <Thickness x:Key="ZenContextMenuGestureMargin">28,0,6,0</Thickness>
    <Thickness x:Key="ZenContextMenuSeparatorMargin">8,5</Thickness>

    <!-- 气泡提示 -->
    <Thickness x:Key="ZenCalloutPadding">14,10</Thickness>
    <CornerRadius x:Key="ZenCalloutCornerRadius">6</CornerRadius>
    <sys:Double x:Key="ZenCalloutMaxWidth">360</sys:Double>
    <sys:Double x:Key="ZenCalloutTriggerSize">24</sys:Double>
    <sys:Double x:Key="ZenCalloutTargetGap">4</sys:Double>

    <!-- 数据网格 -->
    <sys:Double x:Key="ZenDataGridColumnHeaderHeight">44</sys:Double>
    <sys:Double x:Key="ZenDataGridRowMinHeight">44</sys:Double>
    <Thickness x:Key="ZenDataGridCellPadding">14,0</Thickness>
    <Thickness x:Key="ZenDataGridCellFocusVisualBorderThickness">1</Thickness>
    <Thickness x:Key="ZenDataGridCellValidationBorderThickness">2</Thickness>

    <!-- 日历 -->
    <sys:Double x:Key="ZenCalendarPopupWidth">368</sys:Double>
    <sys:Double x:Key="ZenCalendarPopupHeight">376</sys:Double>
    <CornerRadius x:Key="ZenCalendarCornerRadius">8</CornerRadius>
    <Thickness x:Key="ZenCalendarButtonPadding">12,16</Thickness>
    <sys:Double x:Key="ZenCalendarNavigationButtonSize">40</sys:Double>

    <!-- 开关 -->
    <sys:Double x:Key="ZenSwitchWidth">64</sys:Double>
    <sys:Double x:Key="ZenSwitchHeight">30</sys:Double>
    <Thickness x:Key="ZenSwitchThumbMargin">4</Thickness>

    <!-- 滑块 -->
    <sys:Double x:Key="ZenSliderThumbSize">18</sys:Double>
    <sys:Double x:Key="ZenSliderTrackThickness">4</sys:Double>
    <sys:Double x:Key="ZenSliderCrossAxisMinSize">24</sys:Double>

    <!-- 进度条 -->
    <sys:Double x:Key="ZenProgressBarThickness">8</sys:Double>

    <!-- 提示条 -->
    <Thickness x:Key="ZenAlertPadding">14,11</Thickness>

    <!-- 折叠面板 -->
    <Thickness x:Key="ZenExpanderHeaderPadding">14,12</Thickness>
    <Thickness x:Key="ZenExpanderContentPadding">14,10,14,14</Thickness>
    <CornerRadius x:Key="ZenExpanderCornerRadius">8</CornerRadius>
    <sys:Double x:Key="ZenExpanderGlyphSize">16</sys:Double>

    <!-- 按钮式单选组 -->
    <sys:Double x:Key="ZenRadioItemMinHeight">36</sys:Double>
    <Thickness x:Key="ZenRadioItemPadding">14,0</Thickness>
    <CornerRadius x:Key="ZenRadioItemCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ZenRadioItemFocusVisualCornerRadius">13</CornerRadius>
</ResourceDictionary>

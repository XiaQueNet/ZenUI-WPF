<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <zen:CalloutOffsetConverter
        x:Key="ZenCalloutOffsetConverter"
        Gap="{DynamicResource ZenCalloutTargetGap}" />

    <!-- ToolTip 与 Popover 共用的气泡外壳。 -->
    <Style x:Key="ZenCalloutChromeStyle" TargetType="{x:Type zen:ZenCalloutChrome}">
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Padding" Value="{DynamicResource ZenCalloutPadding}" />
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZenCalloutCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenCalloutChrome}">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="CalloutBody"
                            Grid.Row="1"
                            Grid.Column="1"
                            Panel.ZIndex="1"
                            MinWidth="{TemplateBinding MinWidth}"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                TextBlock.LineHeight="{DynamicResource ZenLineHeightBody}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>

                        <Path
                            x:Name="TopArrow"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,-1"
                            HorizontalAlignment="Center"
                            Data="M 0,7 L 7,0 L 14,7 Z"
                            Fill="{TemplateBinding Background}"
                            Stroke="{TemplateBinding BorderBrush}"
                            StrokeThickness="1"
                            Visibility="Collapsed" />
                        <Path
                            x:Name="BottomArrow"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,-1,0,0"
                            HorizontalAlignment="Center"
                            Data="M 0,0 L 14,0 L 7,7 Z"
                            Fill="{TemplateBinding Background}"
                            Stroke="{TemplateBinding BorderBrush}"
                            StrokeThickness="1"
                            Visibility="Collapsed" />
                        <Path
                            x:Name="LeftArrow"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,-1,0"
                            VerticalAlignment="Center"
                            Data="M 7,0 L 0,7 L 7,14 Z"
                            Fill="{TemplateBinding Background}"
                            Stroke="{TemplateBinding BorderBrush}"
                            StrokeThickness="1"
                            Visibility="Collapsed" />
                        <Path
                            x:Name="RightArrow"
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="-1,0,0,0"
                            VerticalAlignment="Center"
                            Data="M 0,0 L 7,7 L 0,14 Z"
                            Fill="{TemplateBinding Background}"
                            Stroke="{TemplateBinding BorderBrush}"
                            StrokeThickness="1"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Popup 在目标上方时，箭头位于气泡底部。 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowArrow" Value="True" />
                                <Condition Property="Placement" Value="{x:Static primitives:PlacementMode.Top}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BottomArrow" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowArrow" Value="True" />
                                <Condition Property="Placement" Value="{x:Static primitives:PlacementMode.Bottom}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TopArrow" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowArrow" Value="True" />
                                <Condition Property="Placement" Value="{x:Static primitives:PlacementMode.Left}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RightArrow" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowArrow" Value="True" />
                                <Condition Property="Placement" Value="{x:Static primitives:PlacementMode.Right}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LeftArrow" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenToolTipStyle" TargetType="{x:Type ToolTip}">
        <Setter Property="Placement" Value="Top" />
        <Setter Property="MaxWidth" Value="{DynamicResource ZenCalloutMaxWidth}" />
        <Setter Property="Padding" Value="{DynamicResource ZenCalloutPadding}" />
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HorizontalOffset">
            <Setter.Value>
                <MultiBinding
                    Converter="{StaticResource ZenCalloutOffsetConverter}"
                    ConverterParameter="Horizontal">
                    <Binding Path="PlacementTarget.ActualWidth" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Placement" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalOffset">
            <Setter.Value>
                <MultiBinding
                    Converter="{StaticResource ZenCalloutOffsetConverter}"
                    ConverterParameter="Vertical">
                    <Binding Path="PlacementTarget.ActualHeight" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Placement" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <zen:ZenCalloutChrome
                        Style="{StaticResource ZenCalloutChromeStyle}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ZenCalloutCornerRadius}"
                        MaxWidth="{TemplateBinding MaxWidth}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        Placement="{TemplateBinding Placement}"
                        ShowArrow="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenToolTipStyle}" TargetType="{x:Type ToolTip}" />

    <Style x:Key="ZenPopoverTriggerStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="MinWidth" Value="{DynamicResource ZenCalloutTriggerSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource ZenCalloutTriggerSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenTextPlaceholderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="TriggerBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="999">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                            <Setter TargetName="TriggerBorder" Property="Background" Value="{DynamicResource ZenInfoLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                            <Setter TargetName="TriggerBorder" Property="Background" Value="{DynamicResource ZenInfoLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TriggerBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledAuxiliaryActionOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenPopoverStyle" TargetType="{x:Type zen:ZenPopover}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="Padding" Value="{DynamicResource ZenCalloutPadding}" />
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZenCalloutCornerRadius}" />
        <Setter Property="ShowArrow" Value="True" />
        <Setter Property="TargetGap" Value="{DynamicResource ZenCalloutTargetGap}" />
        <Setter Property="TriggerStyle" Value="{StaticResource ZenPopoverTriggerStyle}" />
        <Setter Property="MaxPopupWidth" Value="{DynamicResource ZenCalloutMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenPopover}">
                    <Grid>
                        <ToggleButton
                            x:Name="PART_Trigger"
                            Content="{TemplateBinding Trigger}"
                            ContentTemplate="{TemplateBinding TriggerTemplate}"
                            IsChecked="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{TemplateBinding TriggerStyle}" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Placement="{TemplateBinding Placement}"
                            PlacementTarget="{Binding ElementName=PART_Trigger}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Popup.HorizontalOffset>
                                <MultiBinding
                                    Converter="{StaticResource ZenCalloutOffsetConverter}"
                                    ConverterParameter="Horizontal">
                                    <Binding ElementName="PART_Trigger" Path="ActualWidth" />
                                    <Binding ElementName="CalloutChrome" Path="ActualWidth" />
                                    <Binding Path="Placement" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="TargetGap" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Popup.HorizontalOffset>
                            <Popup.VerticalOffset>
                                <MultiBinding
                                    Converter="{StaticResource ZenCalloutOffsetConverter}"
                                    ConverterParameter="Vertical">
                                    <Binding ElementName="PART_Trigger" Path="ActualHeight" />
                                    <Binding ElementName="CalloutChrome" Path="ActualHeight" />
                                    <Binding Path="Placement" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="TargetGap" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Popup.VerticalOffset>
                            <zen:ZenCalloutChrome
                                x:Name="CalloutChrome"
                                Style="{StaticResource ZenCalloutChromeStyle}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                MinWidth="{TemplateBinding MinPopupWidth}"
                                MaxWidth="{TemplateBinding MaxPopupWidth}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                Placement="{TemplateBinding Placement}"
                                ShowArrow="{TemplateBinding ShowArrow}" />
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenPopoverStyle}" TargetType="{x:Type zen:ZenPopover}" />
</ResourceDictionary>

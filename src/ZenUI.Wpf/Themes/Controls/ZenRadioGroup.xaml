<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style x:Key="ZenRadioItemFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        CornerRadius="{DynamicResource ZenRadioItemFocusVisualCornerRadius}"
                        Style="{DynamicResource ZenFocusVisualBorderStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenRadioItemStyle"
        TargetType="{x:Type zen:ZenRadioItem}">
        <Setter Property="MinHeight" Value="{DynamicResource ZenRadioItemMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ZenRadioItemPadding}" />
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ZenControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ZenRadioItemFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenRadioItem}">
                    <Border
                        x:Name="ItemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ZenRadioItemCornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="Content"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ZenBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter
                                TargetName="ItemBorder"
                                Property="BorderBrush"
                                Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                            <Setter Property="Foreground" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition
                                    Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}"
                                    Value="{x:Static zen:RadioGroupAppearance.Filled}" />
                            </MultiDataTrigger.Conditions>
                            <Setter
                                TargetName="ItemBorder"
                                Property="Background"
                                Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                            <Setter
                                TargetName="ItemBorder"
                                Property="BorderBrush"
                                Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenOnAccentBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition
                                    Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}"
                                    Value="{x:Static zen:RadioGroupAppearance.Filled}" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ZenPrimaryHoverBrush}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryHoverBrush}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenRadioItemStyle}" TargetType="{x:Type zen:ZenRadioItem}" />

    <Style
        x:Key="ZenRadioGroupStyle"
        TargetType="{x:Type zen:ZenRadioGroup}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="AccentBrush" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ZenRadioItemStyle}" />
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <zen:ZenRadioGroupPanel
                        IsItemWidthUniform="{Binding IsItemWidthUniform, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}"
                        Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}"
                        Spacing="{Binding Spacing, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenRadioGroup}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            CanContentScroll="False"
                            Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledContainerOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenRadioGroupStyle}" TargetType="{x:Type zen:ZenRadioGroup}" />
</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style x:Key="ZenRadioItemFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        CornerRadius="{DynamicResource ZenRadioItemFocusVisualCornerRadius}"
                        Style="{DynamicResource ZenFocusVisualBorderStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenRadioItemRadioStyle"
        TargetType="{x:Type zen:ZenRadioItem}">
        <Setter Property="MinHeight" Value="{DynamicResource ZenRadioItemMinHeight}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ZenRadioItemFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenRadioItem}">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="Ring"
                                    Fill="{DynamicResource ZenSurfaceBrush}"
                                    Stroke="{DynamicResource ZenBorderBrush}"
                                    StrokeThickness="1" />
                                <Ellipse
                                    x:Name="Dot"
                                    Width="8"
                                    Height="8"
                                    Fill="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                ContentSource="Content"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="Ring"
                                Property="Stroke"
                                Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter
                                TargetName="Ring"
                                Property="Stroke"
                                Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenRadioItemButtonBaseStyle"
        TargetType="{x:Type zen:ZenRadioItem}">
        <Setter Property="MinHeight" Value="{DynamicResource ZenRadioItemMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ZenRadioItemPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ZenRadioItemFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenRadioItem}">
                    <Border
                        x:Name="ItemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ZenRadioItemCornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="Content"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenRadioItemFilledStyle"
        BasedOn="{StaticResource ZenRadioItemButtonBaseStyle}"
        TargetType="{x:Type zen:ZenRadioItem}">
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ZenControlBorderThickness}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                <Setter Property="BorderBrush" Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                <Setter Property="Foreground" Value="{DynamicResource ZenOnSelectionBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource ZenPrimaryHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ZenPrimaryHoverBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ZenRadioItemOutlineStyle"
        BasedOn="{StaticResource ZenRadioItemButtonBaseStyle}"
        TargetType="{x:Type zen:ZenRadioItem}">
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ZenControlBorderThickness}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderBrush" Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                <Setter Property="Foreground" Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ZenRadioItemGhostStyle"
        BasedOn="{StaticResource ZenRadioItemButtonBaseStyle}"
        TargetType="{x:Type zen:ZenRadioItem}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ZenRadioSegmentedSelectedBrush}" />
                <Setter Property="Foreground" Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource ZenRadioSegmentedSelectedHoverBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ZenRadioItemUnderlineStyle"
        BasedOn="{StaticResource ZenRadioItemButtonBaseStyle}"
        TargetType="{x:Type zen:ZenRadioItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenRadioItem}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="Content"
                            RecognizesAccessKey="True" />
                        <Border
                            x:Name="SelectionIndicator"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Background="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenRadioItemSegmentStyle"
        TargetType="{x:Type zen:ZenRadioItem}">
        <Setter Property="MinHeight" Value="{DynamicResource ZenRadioItemMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ZenRadioItemPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ZenRadioItemFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenRadioItem}">
                    <Border
                        x:Name="ItemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource ZenRadioItemInnerCornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentSource="Content"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter
                                TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource ZenRadioSegmentedSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenRadioSegmentedSelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter
                                TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource ZenRadioSegmentedSelectedHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ZenRadioItemRadioStyle}" TargetType="{x:Type zen:ZenRadioItem}" />

    <Style
        x:Key="ZenRadioGroupStyle"
        TargetType="{x:Type zen:ZenRadioGroup}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ZenRadioItemOutlineStyle}" />
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <zen:ZenRadioGroupPanel
                        Appearance="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}"
                        IsItemSizeUniform="{Binding IsItemSizeUniform, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}"
                        Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}"
                        Spacing="{Binding Spacing, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenRadioGroup}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenRadioGroup}">
                    <Border
                        x:Name="GroupBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            zen:ScrollViewerAssist.IsMouseWheelChainingEnabled="True"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            CanContentScroll="False"
                            Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Appearance" Value="{x:Static zen:RadioGroupAppearance.Segmented}">
                            <Setter TargetName="GroupBorder" Property="Background" Value="{DynamicResource ZenSurfaceMutedBrush}" />
                            <Setter TargetName="GroupBorder" Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
                            <Setter TargetName="GroupBorder" Property="BorderThickness" Value="{DynamicResource ZenControlBorderThickness}" />
                            <Setter TargetName="GroupBorder" Property="CornerRadius" Value="{DynamicResource ZenRadioItemCornerRadius}" />
                            <Setter TargetName="GroupBorder" Property="Padding" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledContainerOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Appearance" Value="{x:Static zen:RadioGroupAppearance.Radio}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource ZenRadioItemRadioStyle}" />
            </Trigger>
            <Trigger Property="Appearance" Value="{x:Static zen:RadioGroupAppearance.Filled}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource ZenRadioItemFilledStyle}" />
            </Trigger>
            <Trigger Property="Appearance" Value="{x:Static zen:RadioGroupAppearance.Ghost}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource ZenRadioItemGhostStyle}" />
            </Trigger>
            <Trigger Property="Appearance" Value="{x:Static zen:RadioGroupAppearance.Underline}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource ZenRadioItemUnderlineStyle}" />
            </Trigger>
            <Trigger Property="Appearance" Value="{x:Static zen:RadioGroupAppearance.Segmented}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource ZenRadioItemSegmentStyle}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource ZenRadioGroupStyle}" TargetType="{x:Type zen:ZenRadioGroup}" />
</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style x:Key="ZenSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="{DynamicResource ZenSliderThumbSize}" />
        <Setter Property="Height" Value="{DynamicResource ZenSliderThumbSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Ellipse x:Name="ThumbShape" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbShape" Property="Fill" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbShape" Property="StrokeThickness" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenSliderStyle" TargetType="{x:Type zen:ZenSlider}">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="{DynamicResource ZenSliderCrossAxisMinSize}" />
        <Setter Property="TrackThickness" Value="{DynamicResource ZenSliderTrackThickness}" />
        <Setter Property="Background" Value="{DynamicResource ZenDividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="ThumbBrush" Value="{DynamicResource ZenControlThumbBrush}" />
        <Setter Property="ThumbHoverBrush" Value="{DynamicResource ZenInfoLightBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenSlider}">
                    <Grid x:Name="HorizontalRoot" VerticalAlignment="Center">
                        <Track
                            x:Name="PART_Track"
                            IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                            Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton" Height="{Binding TrackThickness, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Background="{TemplateBinding Foreground}" BorderThickness="0" Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="2" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton" Height="{Binding TrackThickness, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderThickness="0" Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="2" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb
                                    Background="{TemplateBinding ThumbBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Style="{StaticResource ZenSliderThumbStyle}"
                                    Tag="{TemplateBinding ThumbHoverBrush}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="MinWidth" Value="{DynamicResource ZenSliderCrossAxisMinSize}" />
                            <Setter Property="MinHeight" Value="120" />
                            <Setter TargetName="HorizontalRoot" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="HorizontalRoot" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="DecreaseButton" Property="Width" Value="{Binding TrackThickness, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="DecreaseButton" Property="Height" Value="Auto" />
                            <Setter TargetName="DecreaseButton" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="DecreaseButton" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="IncreaseButton" Property="Width" Value="{Binding TrackThickness, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="IncreaseButton" Property="Height" Value="Auto" />
                            <Setter TargetName="IncreaseButton" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="IncreaseButton" Property="VerticalAlignment" Value="Stretch" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledActionOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenSliderStyle}" TargetType="{x:Type zen:ZenSlider}" />
</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style x:Key="ZenSelectionFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border CornerRadius="{DynamicResource ZenSelectionFocusVisualCornerRadius}" Style="{DynamicResource ZenFocusVisualBorderStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenCheckBoxStyle"
        TargetType="{x:Type zen:ZenCheckBox}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="CheckedBackground" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="CheckedBorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="HoverBorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="CheckMarkForeground" Value="{DynamicResource ZenOnAccentBrush}" />
        <Setter Property="ThemeBackground" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="Background" Value="{Binding ThemeBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="{Binding ThemeBorderBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IndicatorSize" Value="{DynamicResource ZenSelectionIndicatorSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ZenSelectionFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenCheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="IndicatorHost"
                            Width="{TemplateBinding IndicatorSize}"
                            Height="{TemplateBinding IndicatorSize}"
                            VerticalAlignment="Center">
                            <Border
                                x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ZenSelectionIndicatorCornerRadius}" />
                            <Viewbox Stretch="Uniform">
                                <Grid Width="18" Height="18">
                                    <Path
                                        x:Name="CheckMark"
                                        Width="10"
                                        Height="7"
                                        Data="M 1,3.5 L 4,6 L 9,1"
                                        Stroke="{TemplateBinding CheckMarkForeground}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Viewbox>
                        </Grid>
                        <ContentPresenter
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            ContentSource="Content"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="ThemeBorderBrush" Value="{Binding HoverBorderBrush, RelativeSource={RelativeSource Self}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="ThemeBackground" Value="{Binding CheckedBackground, RelativeSource={RelativeSource Self}}" />
                            <Setter Property="ThemeBorderBrush" Value="{Binding CheckedBorderBrush, RelativeSource={RelativeSource Self}}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="ThemeBackground" Value="{Binding CheckedBackground, RelativeSource={RelativeSource Self}}" />
                            <Setter Property="ThemeBorderBrush" Value="{Binding CheckedBorderBrush, RelativeSource={RelativeSource Self}}" />
                            <Setter TargetName="CheckMark" Property="Data" Value="M 1,3.5 L 9,3.5" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenCheckBoxStyle}" TargetType="{x:Type zen:ZenCheckBox}" />

    <Style
        x:Key="ZenRadioButtonStyle"
        TargetType="{x:Type zen:ZenRadioButton}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="AccentBrush" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="ThemeBackground" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="Background" Value="{Binding ThemeBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="{Binding ThemeBorderBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="IndicatorSize" Value="{DynamicResource ZenSelectionIndicatorSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ZenSelectionFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenRadioButton}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="IndicatorHost"
                            Width="{TemplateBinding IndicatorSize}"
                            Height="{TemplateBinding IndicatorSize}"
                            VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                            <Viewbox Stretch="Uniform">
                                <Grid Width="18" Height="18">
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="8"
                                        Height="8"
                                        Fill="{TemplateBinding AccentBrush}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Viewbox>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" ContentSource="Content" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="ThemeBorderBrush" Value="{Binding AccentBrush, RelativeSource={RelativeSource Self}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="ThemeBorderBrush" Value="{Binding AccentBrush, RelativeSource={RelativeSource Self}}" />
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenRadioButtonStyle}" TargetType="{x:Type zen:ZenRadioButton}" />
</ResourceDictionary>

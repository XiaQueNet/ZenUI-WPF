<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ZenFocusVisualBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="{DynamicResource ZenFocusVisualMargin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenFocusBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ZenFocusVisualBorderThickness}" />
        <Setter Property="Opacity" Value="{DynamicResource ZenFocusVisualOpacity}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>

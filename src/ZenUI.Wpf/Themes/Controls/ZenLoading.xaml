<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style
        x:Key="ZenLoadingStyle"
        TargetType="{x:Type zen:ZenLoading}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="OverlayBackground" Value="{DynamicResource ZenLoadingOverlayBrush}" />
        <Setter Property="IndicatorSize" Value="{DynamicResource ZenLoadingIndicatorSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenLoading}">
                    <Grid>
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <Border
                            x:Name="LoadingLayer"
                            Background="{TemplateBinding OverlayBackground}"
                            IsHitTestVisible="{TemplateBinding IsContentInteractionBlocked}"
                            Visibility="Collapsed">
                            <StackPanel
                                x:Name="IndicatorPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="{TemplateBinding Orientation}">
                                <Viewbox
                                    x:Name="Indicator"
                                    Width="{TemplateBinding IndicatorSize}"
                                    Height="{TemplateBinding IndicatorSize}"
                                    HorizontalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform>
                                        <RotateTransform x:Name="IndicatorRotation" />
                                    </Viewbox.RenderTransform>
                                    <Path
                                        Width="24"
                                        Height="24"
                                        Data="M 12,2 A 10,10 0 1 1 4.93,4.93"
                                        SnapsToDevicePixels="True"
                                        Stroke="{TemplateBinding Foreground}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="{DynamicResource ZenLoadingIndicatorThickness}" />
                                </Viewbox>
                                <Border
                                    x:Name="ContentSpacing"
                                    Height="{DynamicResource ZenLoadingContentSpacing}" />
                                <TextBlock
                                    x:Name="LoadingText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontStretch="{TemplateBinding FontStretch}"
                                    FontStyle="{TemplateBinding FontStyle}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                    Text="{TemplateBinding LoadingText}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="LoadingLayer" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="LoadingStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndicatorRotation"
                                            Storyboard.TargetProperty="Angle"
                                            From="0"
                                            To="360"
                                            Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LoadingStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="LoadingText" Value="">
                            <Setter TargetName="LoadingText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentSpacing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="LoadingText" Value="{x:Null}">
                            <Setter TargetName="LoadingText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentSpacing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="ContentSpacing" Property="Width" Value="{DynamicResource ZenLoadingContentSpacing}" />
                            <Setter TargetName="ContentSpacing" Property="Height" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Indicator" Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                            <Setter TargetName="LoadingText" Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenLoadingStyle}" TargetType="{x:Type zen:ZenLoading}" />
</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style x:Key="ZenTimePickerTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="{DynamicResource ZenInputControlPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="ZenTimePickerDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="ButtonBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenInfoLightBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenTimePickerStyle" TargetType="{x:Type zen:ZenTimePicker}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="MinHeight" Value="{DynamicResource ZenInputControlMinHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZenInputControlCornerRadius}" />
        <Setter Property="DropDownButtonWidth" Value="{DynamicResource ZenTimePickerDropDownButtonWidth}" />
        <Setter Property="DropDownButtonHeight" Value="{DynamicResource ZenTimePickerDropDownButtonHeight}" />
        <Setter Property="DropDownButtonIconSize" Value="{DynamicResource ZenTimePickerDropDownButtonIconSize}" />
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ZenControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenTimePicker}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="InputBorder"
                            Grid.ColumnSpan="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <Grid x:Name="InputContentHost" ClipToBounds="True">
                            <TextBox
                                x:Name="PART_TextBox"
                                AutomationProperties.Name="时间"
                                Style="{StaticResource ZenTimePickerTextBoxStyle}" />
                            <TextBlock
                                x:Name="WatermarkText"
                                Margin="{DynamicResource ZenInputControlPadding}"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource ZenTextPlaceholderBrush}"
                                IsHitTestVisible="False"
                                Text="{TemplateBinding Watermark}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenTimePicker}}}" Value="True" />
                                                    <Condition Binding="{Binding ShowWatermarkOnFocus, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenTimePicker}}}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ToggleButton
                            x:Name="DropDownButton"
                            Grid.Column="1"
                            Width="{TemplateBinding DropDownButtonWidth}"
                            Height="{TemplateBinding DropDownButtonHeight}"
                            Margin="4,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="打开时间选择器"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Style="{StaticResource ZenTimePickerDropDownButtonStyle}">
                            <Viewbox
                                x:Name="ClockIcon"
                                Width="{TemplateBinding DropDownButtonIconSize}"
                                Height="{TemplateBinding DropDownButtonIconSize}"
                                Stretch="Uniform">
                                <Grid Width="16" Height="16">
                                <Ellipse
                                    Margin="1"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                    StrokeThickness="1.4" />
                                <Path
                                    Data="M 8,4 L 8,8 L 11,10"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.4" />
                                </Grid>
                            </Viewbox>
                        </ToggleButton>

                        <Popup
                            x:Name="PART_Popup"
                            Grid.ColumnSpan="2"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=InputBorder}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Margin="{DynamicResource ZenTimePickerPopupMargin}"
                                Padding="{DynamicResource ZenTimePickerPopupPadding}"
                                Background="{DynamicResource ZenSurfaceBrush}"
                                BorderBrush="{DynamicResource ZenBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ZenTimePickerPopupCornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Opacity="0.16"
                                        ShadowDepth="3"
                                        Color="Black" />
                                </Border.Effect>
                                <StackPanel>
                                    <zen:ZenTimeSelector x:Name="PART_TimeSelector" />
                                    <Border
                                        Margin="4,2,4,0"
                                        Padding="0,8,0,2"
                                        BorderBrush="{DynamicResource ZenDividerBrush}"
                                        BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <zen:ZenButton
                                                x:Name="PART_NowButton"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Height="28"
                                                Padding="6,0"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="选择此刻"
                                                Content="此刻"
                                                Appearance="Text"
                                                Variant="Neutral" />
                                            <zen:ZenButton
                                                x:Name="PART_ConfirmButton"
                                                Grid.Column="1"
                                                MinWidth="64"
                                                MinHeight="0"
                                                Height="32"
                                                AutomationProperties.Name="确定时间"
                                                Content="确定"
                                                Variant="Primary" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsTextInputReadOnly" Value="True">
                            <Setter TargetName="PART_TextBox" Property="IsReadOnly" Value="True" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource ZenSurfaceDisabledBrush}" />
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledFieldOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ZenTimePickerStyle}" TargetType="{x:Type zen:ZenTimePicker}" />
</ResourceDictionary>

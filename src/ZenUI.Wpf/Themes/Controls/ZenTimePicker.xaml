<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style x:Key="ZenTimePickerTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="{DynamicResource ZenInputControlPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsTextInputEnabled, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenTimePicker}}}" Value="False">
                <Setter Property="IsReadOnly" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ZenTimePickerDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="ButtonBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenInfoLightBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenTimePickerListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Width" Value="{DynamicResource ZenTimePickerColumnWidth}" />
        <Setter Property="Height" Value="{DynamicResource ZenTimePickerListHeight}" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    <Setter Property="Height" Value="{DynamicResource ZenTimePickerItemHeight}" />
                    <Setter Property="Margin" Value="{DynamicResource ZenTimePickerItemMargin}" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border
                                    x:Name="ItemBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    CornerRadius="5">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ZenInfoLightBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="{DynamicResource ZenDisabledFieldOpacity}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenTimeSelectorStyle" TargetType="{x:Type zen:ZenTimeSelector}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenTimeSelector}">
                    <StackPanel Orientation="Horizontal">
                        <ListBox
                            x:Name="PART_HourList"
                            AutomationProperties.Name="小时"
                            Style="{StaticResource ZenTimePickerListStyle}" />
                        <Border Width="1" Margin="2,6" Background="{DynamicResource ZenDividerBrush}" />
                        <ListBox
                            x:Name="PART_MinuteList"
                            AutomationProperties.Name="分钟"
                            Style="{StaticResource ZenTimePickerListStyle}" />
                        <Border
                            x:Name="SecondDivider"
                            Width="1"
                            Margin="2,6"
                            Background="{DynamicResource ZenDividerBrush}" />
                        <ListBox
                            x:Name="PART_SecondList"
                            AutomationProperties.Name="秒"
                            Style="{StaticResource ZenTimePickerListStyle}" />
                        <Border
                            x:Name="PeriodDivider"
                            Width="1"
                            Margin="2,6"
                            Background="{DynamicResource ZenDividerBrush}" />
                        <ListBox
                            x:Name="PART_PeriodList"
                            Width="{DynamicResource ZenTimePickerPeriodColumnWidth}"
                            AutomationProperties.Name="上午或下午"
                            Style="{StaticResource ZenTimePickerListStyle}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSecondVisible" Value="False">
                            <Setter TargetName="SecondDivider" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_SecondList" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Is24Hour" Value="True">
                            <Setter TargetName="PeriodDivider" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_PeriodList" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ZenTimeSelectorStyle}" TargetType="{x:Type zen:ZenTimeSelector}" />

    <Style x:Key="ZenTimePickerStyle" TargetType="{x:Type zen:ZenTimePicker}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="MinHeight" Value="{DynamicResource ZenInputControlMinHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZenInputControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ZenControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenTimePicker}">
                    <Grid>
                        <Border
                            x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <TextBox
                            x:Name="PART_TextBox"
                            AutomationProperties.Name="时间"
                            Style="{StaticResource ZenTimePickerTextBoxStyle}" />
                        <TextBlock
                            Margin="{DynamicResource ZenInputControlPadding}"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ZenTextPlaceholderBrush}"
                            IsHitTestVisible="False"
                            Text="{TemplateBinding Watermark}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ToggleButton
                            x:Name="DropDownButton"
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="打开时间选择器"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Style="{StaticResource ZenTimePickerDropDownButtonStyle}">
                            <Grid Width="16" Height="16">
                                <Ellipse
                                    Margin="1"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                    StrokeThickness="1.4" />
                                <Path
                                    Data="M 8,4 L 8,8 L 11,10"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.4" />
                            </Grid>
                        </ToggleButton>

                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=InputBorder}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Margin="{DynamicResource ZenTimePickerPopupMargin}"
                                Padding="{DynamicResource ZenTimePickerPopupPadding}"
                                Background="{DynamicResource ZenSurfaceBrush}"
                                BorderBrush="{DynamicResource ZenBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ZenTimePickerPopupCornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Opacity="0.16"
                                        ShadowDepth="3"
                                        Color="Black" />
                                </Border.Effect>
                                <StackPanel>
                                    <zen:ZenTimeSelector x:Name="PART_TimeSelector" />
                                    <Border
                                        Margin="4,2,4,0"
                                        Padding="0,8,0,2"
                                        BorderBrush="{DynamicResource ZenDividerBrush}"
                                        BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <zen:ZenButton
                                                x:Name="PART_NowButton"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Height="28"
                                                Padding="6,0"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="选择此刻"
                                                Content="此刻"
                                                Appearance="Text"
                                                Variant="Neutral" />
                                            <zen:ZenButton
                                                x:Name="PART_ConfirmButton"
                                                Grid.Column="1"
                                                MinWidth="64"
                                                MinHeight="0"
                                                Height="32"
                                                AutomationProperties.Name="确定时间"
                                                Content="确定"
                                                Variant="Primary" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource ZenSurfaceDisabledBrush}" />
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledFieldOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ZenTimePickerStyle}" TargetType="{x:Type zen:ZenTimePicker}" />
</ResourceDictionary>

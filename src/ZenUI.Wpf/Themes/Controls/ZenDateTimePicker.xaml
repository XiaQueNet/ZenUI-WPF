<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style x:Key="ZenDateTimePickerStyle" TargetType="{x:Type zen:ZenDateTimePicker}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="MinWidth" Value="210" />
        <Setter Property="MinHeight" Value="{DynamicResource ZenInputControlMinHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZenInputControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ZenControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenDateTimePicker}">
                    <Grid>
                        <Border
                            x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <TextBox
                            x:Name="PART_TextBox"
                            AutomationProperties.Name="日期和时间"
                            Style="{DynamicResource ZenTimePickerTextBoxStyle}" />
                        <TextBlock
                            Margin="{DynamicResource ZenInputControlPadding}"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ZenTextPlaceholderBrush}"
                            IsHitTestVisible="False"
                            Text="{TemplateBinding Watermark}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ToggleButton
                            x:Name="DropDownButton"
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="打开日期时间选择器"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Style="{DynamicResource ZenTimePickerDropDownButtonStyle}">
                            <Grid Width="16" Height="16">
                                <Rectangle
                                    Margin="1.5,2.5,1.5,1.5"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                    StrokeThickness="1.3" />
                                <Path
                                    Data="M 2,6 L 14,6 M 5,1.5 L 5,4 M 11,1.5 L 11,4"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.3" />
                                <Ellipse
                                    Width="2.5"
                                    Height="2.5"
                                    Margin="0,0,3,3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" />
                            </Grid>
                        </ToggleButton>

                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=InputBorder}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Margin="{DynamicResource ZenTimePickerPopupMargin}"
                                Padding="{DynamicResource ZenDateTimePickerPopupPadding}"
                                Background="{DynamicResource ZenSurfaceBrush}"
                                BorderBrush="{DynamicResource ZenBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ZenTimePickerPopupCornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Color="Black"
                                        Opacity="0.16"
                                        ShadowDepth="3" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Calendar
                                        x:Name="PART_Calendar"
                                        Width="{DynamicResource ZenDateTimePickerCalendarWidth}"
                                        Height="{DynamicResource ZenDateTimePickerCalendarHeight}"
                                        BorderThickness="0"
                                        FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                        IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                                        SelectionMode="SingleDate"
                                        zen:ZenCalendar.CornerRadius="0"
                                        Style="{DynamicResource ZenCalendarStyle}" />

                                    <Border
                                        Grid.Column="1"
                                        Margin="{DynamicResource ZenDateTimePickerTimePanelMargin}"
                                        Padding="{DynamicResource ZenDateTimePickerTimePanelPadding}"
                                        BorderBrush="{DynamicResource ZenDividerBrush}"
                                        BorderThickness="1,0,0,0">
                                        <zen:ZenTimeSelector
                                            x:Name="PART_TimeSelector"
                                            ColumnWidth="{DynamicResource ZenDateTimePickerTimeColumnWidth}"
                                            ItemHeight="{DynamicResource ZenDateTimePickerTimeItemHeight}"
                                            ListHeight="{DynamicResource ZenDateTimePickerTimeListHeight}"
                                            PeriodColumnWidth="{DynamicResource ZenDateTimePickerPeriodColumnWidth}" />
                                    </Border>

                                    <Border
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="4,2,4,0"
                                        Padding="0,8,0,2"
                                        BorderBrush="{DynamicResource ZenDividerBrush}"
                                        BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <zen:ZenButton
                                                x:Name="PART_NowButton"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Height="28"
                                                Padding="6,0"
                                                HorizontalAlignment="Left"
                                                Appearance="Text"
                                                AutomationProperties.Name="选择此刻"
                                                Content="此刻"
                                                Variant="Neutral" />
                                            <zen:ZenButton
                                                x:Name="PART_ConfirmButton"
                                                Grid.Column="1"
                                                MinWidth="64"
                                                MinHeight="0"
                                                Height="32"
                                                AutomationProperties.Name="确定日期时间"
                                                Content="确定"
                                                Variant="Primary" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenErrorBrush}" />
                        </Trigger>
                        <Trigger Property="IsTextInputEnabled" Value="False">
                            <Setter TargetName="PART_TextBox" Property="IsReadOnly" Value="True" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource ZenSurfaceDisabledBrush}" />
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledFieldOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ZenDateTimePickerStyle}" TargetType="{x:Type zen:ZenDateTimePicker}" />
</ResourceDictionary>

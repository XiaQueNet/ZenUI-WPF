<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <!-- 仅当焦点由键盘操作触发时，WPF 才显示此装饰器。 -->
    <Style x:Key="ZenButtonFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        CornerRadius="{DynamicResource ZenButtonFocusVisualCornerRadius}"
                        Style="{DynamicResource ZenFocusVisualBorderStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenButtonStyle"
        TargetType="{x:Type zen:ZenButton}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZenButtonCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource ZenButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ZenButtonFocusVisualStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="Background" Value="{Binding ThemeBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="{Binding ThemeBorderBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{Binding ThemeForeground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="HoverBackground" Value="{Binding ThemeHoverBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="HoverBorderBrush" Value="{Binding ThemeHoverBorderBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="HoverForeground" Value="{Binding ThemeHoverForeground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="PressedBackground" Value="{Binding ThemePressedBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="PressedBorderBrush" Value="{Binding ThemePressedBorderBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="PressedForeground" Value="{Binding ThemePressedForeground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenButton}">
                    <Border
                        x:Name="BackgroundBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"
                            TextBlock.FontFamily="{TemplateBinding FontFamily}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Neutral">
                <Setter Property="ThemeBackground" Value="{DynamicResource ZenNeutralActionBrush}" />
                <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenNeutralActionBrush}" />
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenOnNeutralActionBrush}" />
                <Setter Property="ThemeHoverBackground" Value="{DynamicResource ZenNeutralActionHoverBrush}" />
                <Setter Property="ThemeHoverBorderBrush" Value="{DynamicResource ZenNeutralActionHoverBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenOnNeutralActionBrush}" />
                <Setter Property="ThemePressedBackground" Value="{DynamicResource ZenNeutralActionPressedBrush}" />
                <Setter Property="ThemePressedBorderBrush" Value="{DynamicResource ZenNeutralActionPressedBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenOnNeutralActionBrush}" />
            </Trigger>
            <Trigger Property="Variant" Value="Primary">
                <Setter Property="ThemeBackground" Value="{DynamicResource ZenPrimaryBrush}" />
                <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenOnAccentBrush}" />
                <Setter Property="ThemeHoverBackground" Value="{DynamicResource ZenPrimaryHoverBrush}" />
                <Setter Property="ThemeHoverBorderBrush" Value="{DynamicResource ZenPrimaryHoverBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenOnAccentBrush}" />
                <Setter Property="ThemePressedBackground" Value="{DynamicResource ZenPrimaryPressedBrush}" />
                <Setter Property="ThemePressedBorderBrush" Value="{DynamicResource ZenPrimaryPressedBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenOnAccentBrush}" />
            </Trigger>
            <Trigger Property="Variant" Value="Success">
                <Setter Property="ThemeBackground" Value="{DynamicResource ZenSuccessActionBrush}" />
                <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenSuccessActionBrush}" />
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenOnAccentBrush}" />
                <Setter Property="ThemeHoverBackground" Value="{DynamicResource ZenSuccessActionHoverBrush}" />
                <Setter Property="ThemeHoverBorderBrush" Value="{DynamicResource ZenSuccessActionHoverBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenOnAccentBrush}" />
                <Setter Property="ThemePressedBackground" Value="{DynamicResource ZenSuccessActionPressedBrush}" />
                <Setter Property="ThemePressedBorderBrush" Value="{DynamicResource ZenSuccessActionPressedBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenOnAccentBrush}" />
            </Trigger>
            <Trigger Property="Variant" Value="Warning">
                <Setter Property="ThemeBackground" Value="{DynamicResource ZenWarningBrush}" />
                <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenWarningBrush}" />
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenWarningForegroundBrush}" />
                <Setter Property="ThemeHoverBackground" Value="{DynamicResource ZenWarningHoverBrush}" />
                <Setter Property="ThemeHoverBorderBrush" Value="{DynamicResource ZenWarningHoverBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenWarningForegroundBrush}" />
                <Setter Property="ThemePressedBackground" Value="{DynamicResource ZenWarningPressedBrush}" />
                <Setter Property="ThemePressedBorderBrush" Value="{DynamicResource ZenWarningPressedBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenWarningForegroundBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Outlined">
                <Setter Property="ThemeBackground" Value="Transparent" />
                <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenNeutralActionBrush}" />
                <Setter Property="BorderThickness" Value="{DynamicResource ZenControlBorderThickness}" />
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenNeutralActionBrush}" />
                <Setter Property="ThemeHoverBackground" Value="{DynamicResource ZenSurfaceMutedBrush}" />
                <Setter Property="ThemeHoverBorderBrush" Value="{DynamicResource ZenNeutralActionHoverBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenNeutralActionHoverBrush}" />
                <Setter Property="ThemePressedBackground" Value="{DynamicResource ZenSurfaceDisabledBrush}" />
                <Setter Property="ThemePressedBorderBrush" Value="{DynamicResource ZenNeutralActionPressedBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenNeutralActionPressedBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Outlined" />
                    <Condition Property="Variant" Value="Primary" />
                </MultiTrigger.Conditions>
                <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenPrimaryBrush}" />
                <Setter Property="ThemeHoverBackground" Value="{DynamicResource ZenInfoLightBrush}" />
                <Setter Property="ThemeHoverBorderBrush" Value="{DynamicResource ZenPrimaryHoverBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenPrimaryHoverBrush}" />
                <Setter Property="ThemePressedBackground" Value="{DynamicResource ZenInfoLightBrush}" />
                <Setter Property="ThemePressedBorderBrush" Value="{DynamicResource ZenPrimaryPressedBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenPrimaryPressedBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Outlined" />
                    <Condition Property="Variant" Value="Success" />
                </MultiTrigger.Conditions>
                <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenSuccessActionBrush}" />
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenSuccessActionBrush}" />
                <Setter Property="ThemeHoverBackground" Value="{DynamicResource ZenSuccessLightBrush}" />
                <Setter Property="ThemeHoverBorderBrush" Value="{DynamicResource ZenSuccessActionHoverBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenSuccessActionHoverBrush}" />
                <Setter Property="ThemePressedBackground" Value="{DynamicResource ZenSuccessLightBrush}" />
                <Setter Property="ThemePressedBorderBrush" Value="{DynamicResource ZenSuccessActionPressedBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenSuccessActionPressedBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Outlined" />
                    <Condition Property="Variant" Value="Warning" />
                </MultiTrigger.Conditions>
                <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenWarningBrush}" />
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenWarningBrush}" />
                <Setter Property="ThemeHoverBackground" Value="{DynamicResource ZenWarningLightBrush}" />
                <Setter Property="ThemeHoverBorderBrush" Value="{DynamicResource ZenWarningHoverBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenWarningHoverBrush}" />
                <Setter Property="ThemePressedBackground" Value="{DynamicResource ZenWarningLightBrush}" />
                <Setter Property="ThemePressedBorderBrush" Value="{DynamicResource ZenWarningPressedBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenWarningPressedBrush}" />
            </MultiTrigger>
            <Trigger Property="Appearance" Value="Text">
                <Setter Property="ThemeBackground" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenNeutralActionBrush}" />
                <Setter Property="ThemeHoverBackground" Value="Transparent" />
                <Setter Property="ThemeHoverBorderBrush" Value="Transparent" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenNeutralActionHoverBrush}" />
                <Setter Property="ThemePressedBackground" Value="Transparent" />
                <Setter Property="ThemePressedBorderBrush" Value="Transparent" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenNeutralActionPressedBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Text" />
                    <Condition Property="Variant" Value="Primary" />
                </MultiTrigger.Conditions>
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenPrimaryBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenPrimaryHoverBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenPrimaryPressedBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Text" />
                    <Condition Property="Variant" Value="Success" />
                </MultiTrigger.Conditions>
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenSuccessActionBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenSuccessActionHoverBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenSuccessActionPressedBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Text" />
                    <Condition Property="Variant" Value="Warning" />
                </MultiTrigger.Conditions>
                <Setter Property="ThemeForeground" Value="{DynamicResource ZenWarningBrush}" />
                <Setter Property="ThemeHoverForeground" Value="{DynamicResource ZenWarningHoverBrush}" />
                <Setter Property="ThemePressedForeground" Value="{DynamicResource ZenWarningPressedBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsPressed" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush" Value="{Binding HoverBorderBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground" Value="{Binding HoverForeground, RelativeSource={RelativeSource Self}}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush" Value="{Binding PressedBorderBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground" Value="{Binding PressedForeground, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource ZenDisabledActionOpacity}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource ZenButtonStyle}" TargetType="{x:Type zen:ZenButton}" />

</ResourceDictionary>

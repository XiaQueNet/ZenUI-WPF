<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style x:Key="ZenCalendarButtonChromeStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="ButtonBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenInfoLightBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledAuxiliaryActionOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenCalendarNavigationButtonStyle"
        BasedOn="{StaticResource ZenCalendarButtonChromeStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" />
    </Style>

    <Style
        x:Key="ZenCalendarHeaderButtonStyle"
        BasedOn="{StaticResource ZenCalendarNavigationButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Padding" Value="{DynamicResource ZenButtonPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="{DynamicResource ZenFontWeightSemibold}" />
    </Style>

    <Style x:Key="ZenCalendarDayButtonStyle" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Grid>
                        <Border
                            x:Name="BlackoutBackground"
                            Background="{DynamicResource ZenSurfaceDisabledBrush}"
                            CornerRadius="5"
                            Opacity="0" />
                        <Border
                            x:Name="DayBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                            <Setter TargetName="DayBorder" Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="{DynamicResource ZenFontWeightSemibold}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource ZenPrimaryBrush}" />
                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ZenTextPlaceholderBrush}" />
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="BlackoutBackground" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenTextPlaceholderBrush}" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledAuxiliaryActionOpacity}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource ZenFocusBrush}" />
                            <Setter TargetName="DayBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenCalendarButtonStyle" TargetType="{x:Type CalendarButton}">
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Border
                        x:Name="MonthBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MonthBorder" Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledAuxiliaryActionOpacity}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="MonthBorder" Property="Background" Value="{DynamicResource ZenInfoLightBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenCalendarItemStyle" TargetType="{x:Type CalendarItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <ControlTemplate.Resources>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}"
                                    Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                    Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="7*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="HeaderPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PART_PreviousButton"
                                Grid.Column="0"
                                Style="{StaticResource ZenCalendarNavigationButtonStyle}">
                                <Path
                                    Width="6"
                                    Height="10"
                                    Data="M 5,1 L 1,5 L 5,9"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Button>
                            <Button
                                x:Name="PART_HeaderButton"
                                Grid.Column="1"
                                Grid.ColumnSpan="5"
                                HorizontalAlignment="Center"
                                Style="{StaticResource ZenCalendarHeaderButtonStyle}" />
                            <Button
                                x:Name="PART_NextButton"
                                Grid.Column="6"
                                Style="{StaticResource ZenCalendarNavigationButtonStyle}">
                                <Path
                                    Width="6"
                                    Height="10"
                                    Data="M 1,1 L 5,5 L 1,9"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Button>
                        </Grid>
                        <Border
                            x:Name="HeaderDivider"
                            Grid.Row="1"
                            Height="0"
                            Background="{DynamicResource ZenDividerBrush}"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True" />
                        <Grid x:Name="PART_MonthView" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                        </Grid>
                        <Grid
                            x:Name="PART_YearView"
                            Grid.Row="2"
                            Visibility="Hidden">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Static CalendarMode.Year}">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static CalendarMode.Decade}">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenCalendarStyle" TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Padding" Value="{DynamicResource ZenCalendarContentMargin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="zen:ZenCalendar.CornerRadius" Value="{DynamicResource ZenCalendarCornerRadius}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource ZenCalendarButtonStyle}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ZenCalendarDayButtonStyle}" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource ZenCalendarItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <Border
                        x:Name="CalendarBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding Path=(zen:ZenCalendar.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <CalendarItem
                            x:Name="PART_CalendarItem"
                            Margin="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Style="{TemplateBinding CalendarItemStyle}"
                            Tag="{TemplateBinding DisplayMode}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenCalendarDefaultStyle"
        BasedOn="{StaticResource ZenCalendarStyle}"
        TargetType="{x:Type zen:ZenCalendar}">
        <Setter Property="Width" Value="{DynamicResource ZenCalendarPopupWidth}" />
        <Setter Property="Height" Value="{DynamicResource ZenCalendarPopupHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeSubtitle}" />
    </Style>

    <Style BasedOn="{StaticResource ZenCalendarDefaultStyle}" TargetType="{x:Type zen:ZenCalendar}" />

</ResourceDictionary>

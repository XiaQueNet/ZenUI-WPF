<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style
        x:Key="ZenAlertStyle"
        TargetType="{x:Type zen:ZenAlert}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Padding" Value="{DynamicResource ZenAlertPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="IconForeground" Value="{DynamicResource ZenOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ThemeBackground" Value="{DynamicResource ZenInfoLightBrush}" />
        <Setter Property="ThemeBorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="ThemeIconBackground" Value="{DynamicResource ZenInfoBrush}" />
        <Setter Property="Background" Value="{Binding ThemeBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="{Binding ThemeBorderBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="IconBackground" Value="{Binding ThemeIconBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenAlert}">
                    <Border
                        x:Name="AlertBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ZenAlertCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid
                                x:Name="IconHost"
                                Width="{TemplateBinding IconSize}"
                                Height="{TemplateBinding IconSize}"
                                VerticalAlignment="Top">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="18" Height="18">
                                        <Ellipse
                                            x:Name="Icon"
                                            Fill="{TemplateBinding IconBackground}" />
                                        <TextBlock x:Name="IconText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource ZenFontSizeCaption}" FontWeight="{DynamicResource ZenFontWeightBold}" Foreground="{TemplateBinding IconForeground}" Text="i" />
                                    </Grid>
                                </Viewbox>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter Property="ThemeBackground" Value="{DynamicResource ZenSuccessLightBrush}" />
                            <Setter Property="ThemeIconBackground" Value="{DynamicResource ZenSuccessBrush}" />
                            <Setter TargetName="IconText" Property="Text" Value="✓" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter Property="ThemeBackground" Value="{DynamicResource ZenWarningLightBrush}" />
                            <Setter Property="ThemeIconBackground" Value="{DynamicResource ZenWarningBrush}" />
                            <Setter TargetName="IconText" Property="Text" Value="!" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter Property="ThemeBackground" Value="{DynamicResource ZenErrorLightBrush}" />
                            <Setter Property="ThemeIconBackground" Value="{DynamicResource ZenErrorBrush}" />
                            <Setter TargetName="IconText" Property="Text" Value="×" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenAlertStyle}" TargetType="{x:Type zen:ZenAlert}" />
</ResourceDictionary>

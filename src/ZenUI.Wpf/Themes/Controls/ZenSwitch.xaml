<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <!--
        仅让 WPF 在键盘触发焦点时显示此装饰器。
        IsKeyboardFocused 模板触发器在鼠标点击后也会触发，
        会让开关看起来始终带有蓝色轮廓。
    -->
    <Style x:Key="ZenSwitchFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        CornerRadius="18"
                        Style="{DynamicResource ZenFocusVisualBorderStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ZenSwitchStyle"
        TargetType="{x:Type zen:ZenSwitch}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Width" Value="{DynamicResource ZenSwitchWidth}" />
        <Setter Property="Height" Value="{DynamicResource ZenSwitchHeight}" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="{DynamicResource ZenSwitchHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ZenSwitchFocusVisualStyle}" />
        <Setter Property="ThemeBackground" Value="{DynamicResource ZenTextPlaceholderBrush}" />
        <Setter Property="Background" Value="{Binding ThemeBackground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenControlThumbBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenControlThumbBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenSwitch}">
                    <Border
                        x:Name="Track"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CapsuleCornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid
                            x:Name="ThumbHost"
                            Width="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalAlignment="Left">
                            <Ellipse
                                Margin="{DynamicResource ZenSwitchThumbMargin}"
                                Fill="{TemplateBinding Foreground}"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="ThemeBackground" Value="{DynamicResource ZenPrimaryBrush}" />
                            <Setter TargetName="ThumbHost" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource ZenDisabledActionOpacity}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource ZenSwitchStyle}" TargetType="{x:Type zen:ZenSwitch}" />

</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ZenUI.Wpf;component/Themes/Controls/ZenCalendar.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ZenDatePickerTextBoxStyle" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                zen:ScrollViewerAssist.IsMouseWheelChainingEnabled="True"
                                Background="Transparent"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                            <TextBlock
                                x:Name="WatermarkText"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{DynamicResource ZenTextPlaceholderBrush}"
                                IsHitTestVisible="False"
                                Text="{Binding Watermark, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenDatePicker}}}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="" />
                                <Condition Binding="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenDatePicker}}}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenDatePickerStyle" TargetType="{x:Type zen:ZenDatePicker}">
        <Setter Property="Padding" Value="{DynamicResource ZenInputControlPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ZenInputControlMinHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZenInputControlCornerRadius}" />
        <Setter Property="CalendarPopupWidth" Value="{DynamicResource ZenCalendarPopupWidth}" />
        <Setter Property="CalendarPopupHeight" Value="{DynamicResource ZenCalendarPopupHeight}" />
        <Setter Property="CalendarFontSize" Value="{DynamicResource ZenFontSizeSubtitle}" />
        <Setter Property="Background" Value="{DynamicResource ZenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ZenBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ZenControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="CalendarStyle" Value="{StaticResource ZenCalendarStyle}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenDatePicker}">
                    <Grid>
                        <Border
                            x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <DatePickerTextBox
                            x:Name="PART_TextBox"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            Foreground="{TemplateBinding Foreground}"
                            Style="{StaticResource ZenDatePickerTextBoxStyle}" />
                        <Button
                            x:Name="PART_Button"
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            Style="{StaticResource ZenCalendarButtonChromeStyle}">
                            <Grid Width="16" Height="16">
                                <Rectangle
                                    Margin="1,3,1,1"
                                    RadiusX="1"
                                    RadiusY="1"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    StrokeThickness="1.4" />
                                <Line
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    StrokeThickness="1.4"
                                    X1="1"
                                    X2="15"
                                    Y1="6"
                                    Y2="6" />
                                <Line
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    StrokeThickness="1.4"
                                    X1="5"
                                    X2="5"
                                    Y1="1"
                                    Y2="5" />
                                <Line
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    StrokeThickness="1.4"
                                    X1="11"
                                    X2="11"
                                    Y1="1"
                                    Y2="5" />
                            </Grid>
                        </Button>
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade"
                            StaysOpen="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsTextInputReadOnly" Value="True">
                            <Setter TargetName="PART_TextBox" Property="IsReadOnly" Value="True" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ZenErrorBrush}" />
                            <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledInputOpacity}" />
                            <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource ZenSurfaceDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ZenDatePickerStyle}" TargetType="{x:Type zen:ZenDatePicker}" />
</ResourceDictionary>

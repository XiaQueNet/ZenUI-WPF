<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style
        x:Key="ZenProgressBarStyle"
        TargetType="{x:Type zen:ZenProgressBar}">
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="Height" Value="{DynamicResource ZenProgressBarThickness}" />
        <Setter Property="Background" Value="{DynamicResource ZenDividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenProgressBar}">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <Grid
                                x:Name="IndeterminateIndicator"
                                Opacity="0"
                                Visibility="Collapsed">
                                <Border
                                    x:Name="HorizontalIndeterminateIndicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TranslateTransform x:Name="HorizontalIndeterminateTransform" X="-1" />
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Offset="0" Color="Transparent" />
                                            <GradientStop Offset="0.22" Color="Transparent" />
                                            <GradientStop Offset="0.38" Color="#66000000" />
                                            <GradientStop Offset="0.5" Color="#FF000000" />
                                            <GradientStop Offset="0.62" Color="#66000000" />
                                            <GradientStop Offset="0.78" Color="Transparent" />
                                            <GradientStop Offset="1" Color="Transparent" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border
                                    x:Name="VerticalIndeterminateIndicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Visibility="Collapsed">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TranslateTransform x:Name="VerticalIndeterminateTransform" Y="1" />
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Offset="0" Color="Transparent" />
                                            <GradientStop Offset="0.22" Color="Transparent" />
                                            <GradientStop Offset="0.38" Color="#66000000" />
                                            <GradientStop Offset="0.5" Color="#FF000000" />
                                            <GradientStop Offset="0.62" Color="#66000000" />
                                            <GradientStop Offset="0.78" Color="Transparent" />
                                            <GradientStop Offset="1" Color="Transparent" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="{DynamicResource ZenProgressBarThickness}" />
                            <Setter Property="Height" Value="Auto" />
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Indicator" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="HorizontalIndeterminateIndicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VerticalIndeterminateIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateIndicator" Property="Opacity" Value="1" />
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="HorizontalIndeterminateTransform"
                                            Storyboard.TargetProperty="X"
                                            From="-1"
                                            To="1"
                                            Duration="0:0:1.5"
                                            AccelerationRatio="0.12"
                                            DecelerationRatio="0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="VerticalIndeterminateTransform"
                                            Storyboard.TargetProperty="Y"
                                            From="1"
                                            To="-1"
                                            Duration="0:0:1.5"
                                            AccelerationRatio="0.12"
                                            DecelerationRatio="0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ZenDisabledItemOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ZenProgressBarStyle}" TargetType="{x:Type zen:ZenProgressBar}" />
</ResourceDictionary>

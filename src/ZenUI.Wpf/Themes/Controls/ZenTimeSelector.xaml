<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="clr-namespace:ZenUI.Wpf.Controls">

    <Style x:Key="ZenTimePickerListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Width" Value="{Binding ColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenTimeSelector}}}" />
        <Setter Property="Height" Value="{Binding ListHeight, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenTimeSelector}}}" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    <Setter Property="Height" Value="{Binding ItemHeight, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenTimeSelector}}}" />
                    <Setter Property="Margin" Value="{DynamicResource ZenTimePickerItemMargin}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border
                                    x:Name="ItemBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ZenSurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ZenInfoLightBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="{DynamicResource ZenDisabledFieldOpacity}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZenTimeSelectorStyle" TargetType="{x:Type zen:ZenTimeSelector}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ColumnWidth" Value="{DynamicResource ZenTimePickerColumnWidth}" />
        <Setter Property="PeriodColumnWidth" Value="{DynamicResource ZenTimePickerPeriodColumnWidth}" />
        <Setter Property="ListHeight" Value="{DynamicResource ZenTimePickerListHeight}" />
        <Setter Property="ItemHeight" Value="{DynamicResource ZenTimePickerItemHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type zen:ZenTimeSelector}">
                    <StackPanel Orientation="Horizontal">
                        <ListBox
                            x:Name="PART_HourList"
                            AutomationProperties.Name="小时"
                            Style="{StaticResource ZenTimePickerListStyle}" />
                        <Border
                            Width="1"
                            Margin="2,6"
                            Background="{DynamicResource ZenDividerBrush}" />
                        <ListBox
                            x:Name="PART_MinuteList"
                            AutomationProperties.Name="分钟"
                            Style="{StaticResource ZenTimePickerListStyle}" />
                        <Border
                            x:Name="SecondDivider"
                            Width="1"
                            Margin="2,6"
                            Background="{DynamicResource ZenDividerBrush}" />
                        <ListBox
                            x:Name="PART_SecondList"
                            AutomationProperties.Name="秒"
                            Style="{StaticResource ZenTimePickerListStyle}" />
                        <Border
                            x:Name="PeriodDivider"
                            Width="1"
                            Margin="2,6"
                            Background="{DynamicResource ZenDividerBrush}" />
                        <ListBox
                            x:Name="PART_PeriodList"
                            Width="{Binding PeriodColumnWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            AutomationProperties.Name="AM 或 PM"
                            Style="{StaticResource ZenTimePickerListStyle}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSecondVisible" Value="False">
                            <Setter TargetName="SecondDivider" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_SecondList" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Is24HourFormat" Value="True">
                            <Setter TargetName="PeriodDivider" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_PeriodList" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ZenTimeSelectorStyle}" TargetType="{x:Type zen:ZenTimeSelector}" />
</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Compatibility entry point for the default light-theme color tokens.
        Applications may continue to merge Colors.xaml or Generic.xaml directly.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ZenUI.Wpf;component/Themes/Tokens/SemanticColors.xaml" />
        <ResourceDictionary Source="/ZenUI.Wpf;component/Themes/Tokens/ComponentColors.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        默认浅色主题颜色 Token 的兼容入口。
        应用可以继续直接合并 Colors.xaml 或 Generic.xaml。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ZenUI.Wpf;component/Themes/Tokens/SemanticColors.xaml" />
        <ResourceDictionary Source="/ZenUI.Wpf;component/Themes/Tokens/ComponentColors.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>

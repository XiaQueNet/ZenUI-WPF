<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <!-- 宿主提供 DataContext；应用资源需合并 Generic.xaml。契约见 references/recipes.md。 -->
    <zen:ZenLoading IsLoading="{Binding IsBusy}" LoadingText="正在保存…"
        DisplayDelay="00:00:00.2">
        <Border Padding="24" Background="{DynamicResource ZenSurfaceBrush}">
            <StackPanel>
                <TextBlock Margin="0,0,0,16" Text="编辑信息" FontSize="20"
                    Foreground="{DynamicResource ZenTextPrimaryBrush}" />
                <Label Content="名称" Target="{Binding ElementName=NameInput}"
                    Foreground="{DynamicResource ZenTextPrimaryBrush}" />
                <zen:ZenTextBox x:Name="NameInput" Watermark="请输入名称"
                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True}" />
                <Label Margin="0,12,0,0" Content="数量" Target="{Binding ElementName=QuantityInput}"
                    Foreground="{DynamicResource ZenTextPrimaryBrush}" />
                <zen:ZenNumberBox x:Name="QuantityInput" Minimum="0" Maximum="999" Increment="1"
                    AutomationProperties.Name="数量" Value="{Binding Quantity, Mode=TwoWay}" />
                <Label Margin="0,12,0,0" Content="截止日期" Target="{Binding ElementName=DateInput}"
                    Foreground="{DynamicResource ZenTextPrimaryBrush}" />
                <zen:ZenDatePicker x:Name="DateInput" Watermark="选择日期"
                    AutomationProperties.Name="截止日期" SelectedDate="{Binding DueDate, Mode=TwoWay}" />
                <zen:ZenCheckBox Margin="0,16,0,0" Content="启用此项目"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                <zen:ZenButton Margin="0,20,0,0" HorizontalAlignment="Right"
                    Content="保存" Variant="Primary" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </zen:ZenLoading>
</UserControl>

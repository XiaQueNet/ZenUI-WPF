<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">

    <SolidColorBrush x:Key="GalleryOnPrimarySecondaryBrush" Color="#DFE6FA" />
    <SolidColorBrush x:Key="GalleryOnPrimaryMutedSurfaceBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="GallerySuccessForegroundBrush" Color="#064E2C" />
    <SolidColorBrush x:Key="GalleryErrorForegroundBrush" Color="#681515" />
    <Thickness x:Key="GalleryPagePadding">48,40,48,56</Thickness>
    <Thickness x:Key="GalleryPageDescriptionMargin">0,8,0,36</Thickness>
    <Thickness x:Key="GallerySectionMargin">0,0,0,36</Thickness>
    <Thickness x:Key="GallerySectionDescriptionMargin">0,0,0,12</Thickness>
    <Thickness x:Key="GalleryFieldMargin">0,0,18,14</Thickness>
    <Thickness x:Key="GalleryFieldLabelMargin">0,0,0,8</Thickness>
    <Thickness x:Key="GallerySupportingTextMargin">0,4,0,0</Thickness>
    <Thickness x:Key="GalleryListRowPadding">0,12</Thickness>
    <Thickness x:Key="GalleryTrailingControlMargin">24,0,0,0</Thickness>

    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeDisplay}" />
        <Setter Property="FontWeight" Value="{DynamicResource ZenFontWeightSemibold}" />
        <Setter Property="LineHeight" Value="{DynamicResource ZenLineHeightDisplay}" />
    </Style>

    <Style x:Key="PageDescriptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="{StaticResource GalleryPageDescriptionMargin}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
        <Setter Property="LineHeight" Value="{DynamicResource ZenLineHeightBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="{DynamicResource ZenFontWeightSemibold}" />
    </Style>

    <Style x:Key="GalleryFieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="{StaticResource GalleryFieldLabelMargin}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBodySmall}" />
    </Style>

    <Style x:Key="GallerySupportingTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="{StaticResource GallerySupportingTextMargin}" />
        <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeCaption}" />
        <Setter Property="LineHeight" Value="{DynamicResource ZenLineHeightCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="GallerySectionDescriptionStyle"
        BasedOn="{StaticResource GallerySupportingTextStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="{StaticResource GallerySectionDescriptionMargin}" />
    </Style>

    <Style x:Key="GalleryWrapFieldStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Width" Value="220" />
        <Setter Property="Margin" Value="{StaticResource GalleryFieldMargin}" />
    </Style>

    <Style x:Key="GalleryCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="{StaticResource GallerySectionMargin}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style
        x:Key="GalleryButtonStyle"
        BasedOn="{StaticResource ZenButtonStyle}"
        TargetType="{x:Type zen:ZenButton}">
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
</ResourceDictionary>

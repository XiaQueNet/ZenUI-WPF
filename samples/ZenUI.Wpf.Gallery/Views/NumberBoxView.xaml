<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.NumberBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <UserControl.Resources>
        <DataTemplate x:Key="NumberBoxIncreaseTemplate">
            <Border Padding="8,2" Background="#FFDDF7F2" CornerRadius="8">
                <TextBlock FontWeight="Bold" Foreground="#FF00695C" Text="{Binding}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="NumberBoxDecreaseTemplate">
            <Border Padding="8,2" Background="#FFFFE29A" CornerRadius="8">
                <TextBlock FontWeight="Bold" Foreground="#FF6B3A00" Text="{Binding}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer Padding="{StaticResource GalleryPagePadding}" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Description="支持范围约束、可配置步长和两种按钮布局。" Title="NumberBox 数字输入框" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="左右增减按钮" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="适合数量、页码等需要醒目操作按钮的场景。" />
                    <zen:ZenNumberBox
                        Width="180"
                        HorizontalAlignment="Left"
                        Maximum="20"
                        Minimum="0"
                        SpinButtonWidth="42"
                        Increment="1"
                        Value="5" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="右侧上下按钮" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="紧凑布局，步长设为 0.5，值始终限制在 0–10。" />
                    <zen:ZenNumberBox
                        Width="180"
                        HorizontalAlignment="Left"
                        SpinButtonLayout="Vertical"
                        Maximum="10"
                        Minimum="0"
                        SpinButtonWidth="32"
                        Increment="0.5"
                        Value="2.5" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="自定义按钮内容" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="通过 IncreaseButtonContent 和 DecreaseButtonContent 将默认图标替换为“加”和“减”。" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenNumberBox
                            Width="180"
                            DecreaseButtonContent="减"
                            IncreaseButtonContent="加"
                            Maximum="20"
                            Minimum="0"
                            SpinButtonWidth="42"
                            Value="5" />
                        <zen:ZenNumberBox
                            Width="180"
                            Margin="16,0,0,0"
                            DecreaseButtonContent="减"
                            IncreaseButtonContent="加"
                            Maximum="20"
                            Minimum="0"
                            SpinButtonLayout="Vertical"
                            SpinButtonWidth="32"
                            Value="5" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="按钮模板与编辑区命令" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="按钮 ContentTemplate 可完整定制增减按钮；点击数字编辑区域时会执行 EditorClickCommand 并传递参数。" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenNumberBox
                            Width="230"
                            DecreaseButtonContent="−10"
                            DecreaseButtonContentTemplate="{StaticResource NumberBoxDecreaseTemplate}"
                            EditorClickCommand="{Binding EditorFeedbackCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            EditorClickCommandParameter="库存数量"
                            IncreaseButtonContent="+10"
                            IncreaseButtonContentTemplate="{StaticResource NumberBoxIncreaseTemplate}"
                            Increment="10"
                            SpinButtonWidth="64"
                            Value="50" />
                        <TextBlock
                            x:Name="EditorCommandStatus"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource GallerySupportingTextStyle}"
                            Text="尚未点击数字编辑区域。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="路由命令" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="IncreaseCommand 和 DecreaseCommand 可绑定到外部操作入口，并自动遵循数值范围和禁用状态。" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenNumberBox
                            x:Name="CommandNumberBox"
                            Width="180"
                            Maximum="10"
                            Minimum="0"
                            Value="5" />
                        <Button
                            Margin="16,0,0,0"
                            Command="{x:Static zen:ZenNumberBox.DecreaseCommand}"
                            CommandTarget="{Binding ElementName=CommandNumberBox}"
                            Content="减少" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{x:Static zen:ZenNumberBox.IncreaseCommand}"
                            CommandTarget="{Binding ElementName=CommandNumberBox}"
                            Content="增加" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="状态" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenNumberBox
                            Width="180"
                            IsReadOnly="True"
                            Increment="10"
                            Value="100" />
                        <zen:ZenNumberBox
                            Width="180"
                            Margin="16,0,0,0"
                            SpinButtonLayout="Vertical"
                            IsEnabled="False"
                            Value="12" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="左：只读文本（按钮可用）　右：禁用" />
                </StackPanel>
            </Border>
            <gallery:PropertyTable ControlType="{x:Type zen:ZenNumberBox}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.TimePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="TimePicker 时间选择器" Description="支持键盘输入、弹层选择、时间范围以及 12/24 小时制。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本用法与状态" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="待选择" />
                            <zen:ZenTimePicker Watermark="请选择时间" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="已选择" />
                            <zen:ZenTimePicker>
                                <zen:ZenTimePicker.SelectedTime>
                                    <sys:TimeSpan>09:30:00</sys:TimeSpan>
                                </zen:ZenTimePicker.SelectedTime>
                            </zen:ZenTimePicker>
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="仅弹层选择" />
                            <zen:ZenTimePicker IsTextInputEnabled="False" Watermark="请从列表选择" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="禁用" />
                            <zen:ZenTimePicker IsEnabled="False" Watermark="不可用" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="显示格式" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="24 小时制" />
                            <zen:ZenTimePicker
                                Width="210"
                                HorizontalAlignment="Left"
                                IsSecondVisible="False">
                                <zen:ZenTimePicker.SelectedTime>
                                    <sys:TimeSpan>18:45:00</sys:TimeSpan>
                                </zen:ZenTimePicker.SelectedTime>
                            </zen:ZenTimePicker>
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="12 小时制" />
                            <zen:ZenTimePicker
                                Width="210"
                                HorizontalAlignment="Left"
                                Is24Hour="False">
                                <zen:ZenTimePicker.SelectedTime>
                                    <sys:TimeSpan>18:45:00</sys:TimeSpan>
                                </zen:ZenTimePicker.SelectedTime>
                            </zen:ZenTimePicker>
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="显示秒" />
                            <zen:ZenTimePicker
                                Width="210"
                                HorizontalAlignment="Left"
                                IsSecondVisible="True"
                                SecondIncrement="5">
                                <zen:ZenTimePicker.SelectedTime>
                                    <sys:TimeSpan>09:30:25</sys:TimeSpan>
                                </zen:ZenTimePicker.SelectedTime>
                            </zen:ZenTimePicker>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="步长与时间约束" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="营业时间为 09:00–18:00，分钟按 15 分钟递增。" />
                    <zen:ZenTimePicker
                        Width="220"
                        HorizontalAlignment="Left"
                        MinuteIncrement="15"
                        Watermark="选择营业时间">
                        <zen:ZenTimePicker.Minimum>
                            <sys:TimeSpan>09:00:00</sys:TimeSpan>
                        </zen:ZenTimePicker.Minimum>
                        <zen:ZenTimePicker.Maximum>
                            <sys:TimeSpan>18:00:00</sys:TimeSpan>
                        </zen:ZenTimePicker.Maximum>
                    </zen:ZenTimePicker>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="圆角与尺寸" />
                    <WrapPanel VerticalAlignment="Bottom">
                        <zen:ZenTimePicker
                            Width="190"
                            Height="32"
                            Margin="{StaticResource GalleryFieldMargin}"
                            CornerRadius="0"
                            Watermark="紧凑 · 32px" />
                        <zen:ZenTimePicker
                            Width="210"
                            Height="36"
                            Margin="{StaticResource GalleryFieldMargin}"
                            Watermark="默认 · 36px" />
                        <zen:ZenTimePicker
                            Width="230"
                            Height="44"
                            Margin="{StaticResource GalleryFieldMargin}"
                            CornerRadius="18"
                            Watermark="宽松 · 44px" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <gallery:PropertyTable ControlType="{x:Type zen:ZenTimePicker}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

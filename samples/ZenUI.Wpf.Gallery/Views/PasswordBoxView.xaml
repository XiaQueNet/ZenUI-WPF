<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.PasswordBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="PasswordBox 密码框" Description="用于安全输入密码等敏感文本，支持水印、自定义圆角以及可选的密码显示与隐藏功能。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本用法" />
                    <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="密码" />
                    <zen:ZenPasswordBox
                        Width="320"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="密码"
                        Watermark="请输入密码" />
                </StackPanel>
            </Border>

            <zen:ZenAlert Margin="0,0,0,18" Severity="Warning">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="避免暴露密码明文" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="通过 PasswordChanged 获知内容变化，仅在需要时读取并及时释放 SecurePassword。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </zen:ZenAlert>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="交互配置" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="使用右侧开关实时体验显隐功能；即使密码为空，启用后眼睛按钮也会保持显示。"
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <StackPanel Width="360" Margin="0,0,32,18" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="可配置密码框" />
                            <zen:ZenPasswordBox
                                x:Name="InteractivePasswordBox"
                                Width="320"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="可配置密码框"
                                IsEnabled="{Binding IsChecked, ElementName=ControlEnabledSwitch}"
                                IsPasswordRevealButtonEnabled="{Binding IsChecked, ElementName=RevealEnabledSwitch}"
                                Watermark="输入内容后点击眼睛" />
                            <TextBlock
                                Margin="0,10,0,0"
                                Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                Text="{Binding IsPasswordRevealed, ElementName=InteractivePasswordBox, StringFormat=当前明文状态：{0}}" />
                        </StackPanel>

                        <Border
                            Width="280"
                            Margin="0,0,0,18"
                            Padding="18"
                            Background="{DynamicResource ZenSurfaceMutedBrush}"
                            CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock VerticalAlignment="Center" Text="启用眼睛按钮" />
                                    <zen:ZenSwitch
                                        x:Name="RevealEnabledSwitch"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="启用眼睛按钮"
                                        IsChecked="True" />
                                </Grid>
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Text="启用密码框" />
                                    <zen:ZenSwitch
                                        x:Name="ControlEnabledSwitch"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="启用密码框"
                                        IsChecked="True" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="圆角与尺寸" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="直角 · CornerRadius=0" />
                            <zen:ZenPasswordBox
                                CornerRadius="0"
                                IsPasswordRevealButtonEnabled="True"
                                Watermark="直角密码框" />
                        </StackPanel>
                        <StackPanel Margin="5,0">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="默认 · CornerRadius=6" />
                            <zen:ZenPasswordBox
                                CornerRadius="6"
                                IsPasswordRevealButtonEnabled="True"
                                Watermark="默认圆角" />
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="胶囊 · CornerRadius=18" />
                            <zen:ZenPasswordBox
                                CornerRadius="18"
                                IsPasswordRevealButtonEnabled="True"
                                Watermark="大圆角密码框" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="控件状态" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="正常状态" />
                            <zen:ZenPasswordBox IsPasswordRevealButtonEnabled="True" Watermark="可以输入密码" />
                        </StackPanel>
                        <StackPanel Margin="5,0">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="禁用显隐功能" />
                            <zen:ZenPasswordBox Watermark="没有眼睛按钮" />
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="禁用状态" />
                            <zen:ZenPasswordBox
                                IsEnabled="False"
                                IsPasswordRevealButtonEnabled="True"
                                Watermark="不可输入" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <gallery:PropertyTable ControlType="{x:Type zen:ZenPasswordBox}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

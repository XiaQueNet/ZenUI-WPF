<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.ExpanderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <UserControl.Resources>
        <Style x:Key="SettingsRowStyle" TargetType="{x:Type Border}">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="50,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource ZenDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="{x:Type zen:ZenComboBox}">
            <Setter Property="Width" Value="164" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="Expander 折叠面板" Description="按需显示补充内容，减少页面中的视觉负担。" />
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本用法" />
                    <zen:ZenExpander Header="配送与退换说明" IsExpanded="True">
                        <TextBlock Text="订单将在 1–2 个工作日内发出。签收后 7 天内，如商品保持完好，可申请退换。" TextWrapping="Wrap" />
                    </zen:ZenExpander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="丰富内容" />
                    <zen:ZenExpander Padding="0">
                        <zen:ZenExpander.Header>
                            <Border>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="{DynamicResource ZenFontSizeSubtitle}"
                                        FontWeight="{DynamicResource ZenFontWeightSemibold}"
                                        Text="任务栏行为" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="{DynamicResource ZenFontSizeCaption}"
                                        FontWeight="{DynamicResource ZenFontWeightRegular}"
                                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                        Text="任务栏对齐、标记、自动隐藏和多个显示器" />
                                </StackPanel>
                            </Border>
                        </zen:ZenExpander.Header>
                        <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="任务栏对齐方式" />
                                    <zen:ZenComboBox
                                        Grid.Column="1"
                                        SelectedIndex="0"
                                        Style="{StaticResource SettingsComboBoxStyle}">
                                        <ComboBoxItem Content="居中" />
                                        <ComboBoxItem Content="靠左" />
                                    </zen:ZenComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <zen:ZenCheckBox Content="自动隐藏任务栏" />
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <zen:ZenCheckBox Content="在任务栏应用上显示徽章" IsChecked="True" />
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <zen:ZenCheckBox Content="显示任务栏应用上的闪烁" IsChecked="True" />
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <zen:ZenCheckBox Content="在所有显示器上显示任务栏" IsChecked="True" />
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="当使用多个显示器时，在以下位置显示我的任务栏应用"
                                        TextWrapping="Wrap" />
                                    <zen:ZenComboBox
                                        Grid.Column="1"
                                        SelectedIndex="0"
                                        Style="{StaticResource SettingsComboBoxStyle}">
                                        <ComboBoxItem Content="所有任务栏" />
                                        <ComboBoxItem Content="主任务栏" />
                                        <ComboBoxItem Content="窗口所在任务栏" />
                                    </zen:ZenComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <zen:ZenCheckBox Content="从任务栏共享任何窗口" IsChecked="True" />
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <zen:ZenCheckBox Content="单击任务栏右下角以显示桌面" IsChecked="True" />
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="合并任务栏按钮并隐藏标签" />
                                    <zen:ZenComboBox
                                        Grid.Column="1"
                                        SelectedIndex="0"
                                        Style="{StaticResource SettingsComboBoxStyle}">
                                        <ComboBoxItem Content="始终" />
                                        <ComboBoxItem Content="任务栏已满时" />
                                        <ComboBoxItem Content="从不" />
                                    </zen:ZenComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="显示较小的任务栏按钮" />
                                    <zen:ZenComboBox
                                        Grid.Column="1"
                                        SelectedIndex="0"
                                        Style="{StaticResource SettingsComboBoxStyle}">
                                        <ComboBoxItem Content="从不" />
                                        <ComboBoxItem Content="任务栏已满时" />
                                        <ComboBoxItem Content="始终" />
                                    </zen:ZenComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </zen:ZenExpander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="组合内容" />
                    <zen:ZenExpander Header="高级设置">
                        <StackPanel>
                            <zen:ZenCheckBox Content="启用诊断日志" />
                            <zen:ZenCheckBox
                                Margin="0,12,0,0"
                                Content="随系统启动"
                                IsChecked="True" />
                        </StackPanel>
                    </zen:ZenExpander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="自定义标题" />
                    <zen:ZenExpander>
                        <zen:ZenExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="{DynamicResource ZenFontWeightSemibold}" Text="通知偏好" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="{DynamicResource ZenFontSizeCaption}"
                                        FontWeight="{DynamicResource ZenFontWeightRegular}"
                                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                        Text="管理应用内消息和系统通知" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ZenInfoLightBrush}"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="{DynamicResource ZenFontSizeCaption}"
                                        Foreground="{DynamicResource ZenPrimaryBrush}"
                                        Text="3 项" />
                                </Border>
                            </Grid>
                        </zen:ZenExpander.Header>
                        <TextBlock Text="邮件通知、桌面通知、产品更新。" />
                    </zen:ZenExpander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="状态" />
                    <zen:ZenExpander Header="默认折叠" />
                    <zen:ZenExpander
                        Margin="0,14,0,0"
                        Header="禁用状态"
                        IsEnabled="False" />
                </StackPanel>
            </Border>
            <gallery:PropertyTable ControlType="{x:Type zen:ZenExpander}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.RadioButtonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="RadioButton 单选按钮" Description="用于在一组互斥选项中选择唯一一项。" />
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="选择状态" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenRadioButton
                            Margin="0,0,28,0"
                            Content="选项 A"
                            GroupName="GalleryOptions"
                            IsChecked="True" />
                        <zen:ZenRadioButton
                            Margin="0,0,28,0"
                            Content="选项 B"
                            GroupName="GalleryOptions" />
                        <zen:ZenRadioButton Content="选项 C" GroupName="GalleryOptions" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="禁用状态" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenRadioButton
                            Margin="0,0,28,0"
                            Content="未选中禁用"
                            GroupName="DisabledOptions"
                            IsEnabled="False" />
                        <zen:ZenRadioButton
                            Content="选中禁用"
                            GroupName="DisabledOptions"
                            IsChecked="True"
                            IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外观定制" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="HoverBorderBrush、CheckedBorderBrush 和 CheckedGlyphBrush 分别控制悬停外圈、选中外圈与选中圆点；IndicatorSize 控制选择指示器的直径。" />
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock
                            Width="88"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Style="{StaticResource GalleryFieldLabelStyle}"
                            Text="交互颜色" />
                        <StackPanel Orientation="Horizontal">
                            <zen:ZenRadioButton
                                Margin="0,0,28,0"
                                CheckedBorderBrush="#FF7C3AED"
                                CheckedGlyphBrush="#FFF59E0B"
                                Content="悬停或选择"
                                GroupName="CustomColorOptions"
                                HoverBorderBrush="#FF06B6D4" />
                            <zen:ZenRadioButton
                                CheckedBorderBrush="#FF7C3AED"
                                CheckedGlyphBrush="#FFF59E0B"
                                Content="彩色选中状态"
                                GroupName="CustomColorOptions"
                                HoverBorderBrush="#FF06B6D4"
                                IsChecked="True" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock
                            Width="88"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Style="{StaticResource GalleryFieldLabelStyle}"
                            Text="标识尺寸" />
                        <StackPanel Orientation="Horizontal">
                            <zen:ZenRadioButton
                                Margin="0,0,28,0"
                                Content="14"
                                GroupName="IndicatorSize14"
                                IndicatorSize="14"
                                IsChecked="True" />
                            <zen:ZenRadioButton
                                Margin="0,0,28,0"
                                Content="18"
                                GroupName="IndicatorSize18"
                                IndicatorSize="18"
                                IsChecked="True" />
                            <zen:ZenRadioButton
                                Content="24"
                                GroupName="IndicatorSize24"
                                IndicatorSize="24"
                                IsChecked="True" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="垂直选项组" />
                    <zen:ZenRadioButton
                        Margin="0,0,0,14"
                        Content="标准版"
                        GroupName="PlanOptions" />
                    <zen:ZenRadioButton
                        Margin="0,0,0,14"
                        Content="专业版"
                        GroupName="PlanOptions"
                        IsChecked="True" />
                    <zen:ZenRadioButton Content="企业版" GroupName="PlanOptions" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="带说明的选项" />
                    <zen:ZenRadioButton GroupName="DeployOptions" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="自动发布" />
                            <TextBlock Style="{StaticResource GallerySupportingTextStyle}" Text="代码合并后自动构建并部署到测试环境。" />
                        </StackPanel>
                    </zen:ZenRadioButton>
                    <zen:ZenRadioButton Margin="0,18,0,0" GroupName="DeployOptions">
                        <StackPanel>
                            <TextBlock Text="手动发布" />
                            <TextBlock Style="{StaticResource GallerySupportingTextStyle}" Text="由负责人确认构建结果后再执行部署。" />
                        </StackPanel>
                    </zen:ZenRadioButton>
                </StackPanel>
            </Border>
            <gallery:PropertyTable ControlType="{x:Type zen:ZenRadioButton}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

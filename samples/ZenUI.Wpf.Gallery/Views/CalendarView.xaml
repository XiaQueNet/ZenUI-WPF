<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.CalendarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="Calendar 日历" Description="支持单日、多日和日期范围选择，并自动适配主题与界面密度。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本用法" />
                    <zen:ZenCalendar
                        HorizontalAlignment="Left"
                        DisplayDate="2026-07-01"
                        SelectedDate="2026-07-27" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="选择模式" />
                    <WrapPanel>
                        <StackPanel Width="412" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="单个范围" />
                            <zen:ZenCalendar
                                HorizontalAlignment="Left"
                                DisplayDate="2026-07-01"
                                SelectionMode="SingleRange" />
                        </StackPanel>
                        <StackPanel Width="412" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="多个范围" />
                            <zen:ZenCalendar
                                HorizontalAlignment="Left"
                                DisplayDate="2026-07-01"
                                SelectionMode="MultipleRange" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="自定义外观与尺寸" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="圆角、整体尺寸、月份按钮内边距和导航按钮尺寸可单独覆盖。" />
                    <zen:ZenCalendar
                        Width="326"
                        Height="340"
                        HorizontalAlignment="Left"
                        ButtonPadding="8,12"
                        CornerRadius="16"
                        DisplayDate="2026-07-01"
                        NavigationButtonSize="34" />
                </StackPanel>
            </Border>
            <gallery:PropertyTable ControlType="{x:Type zen:ZenCalendar}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

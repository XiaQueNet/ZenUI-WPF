<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.DateTimePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="DateTimePicker 日期时间选择器" Description="在一个输入入口中组合日期和时间，并在确认后统一提交。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本用法与状态" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="待选择" />
                            <zen:ZenDateTimePicker Watermark="请选择日期和时间" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="已选择" />
                            <zen:ZenDateTimePicker x:Name="SelectedDateTimePicker" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="仅弹层选择" />
                            <zen:ZenDateTimePicker IsTextInputReadOnly="True" Watermark="请从弹层选择" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="禁用" />
                            <zen:ZenDateTimePicker IsEnabled="False" Watermark="不可用" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="时间格式" />
                    <WrapPanel>
                        <StackPanel Width="250" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="24 小时制 · 不显示秒" />
                            <zen:ZenDateTimePicker
                                x:Name="TwentyFourHourPicker"
                                Width="250"
                                IsSecondVisible="False" />
                        </StackPanel>
                        <StackPanel Width="280" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="12 小时制 · 显示秒" />
                            <zen:ZenDateTimePicker
                                x:Name="TwelveHourPicker"
                                Width="280"
                                Is24Hour="False"
                                IsSecondVisible="True"
                                SecondIncrement="5" />
                        </StackPanel>
                        <StackPanel Width="250" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="自定义格式" />
                            <zen:ZenDateTimePicker
                                x:Name="CustomFormatPicker"
                                Width="250"
                                DateTimeFormat="yyyy/MM/dd HH:mm" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="日期时间范围" />
                    <TextBlock Style="{StaticResource GallerySectionDescriptionStyle}" Text="限制未来七天内的营业时间边界；首日和末日的可选时间会自动收窄。" />
                    <zen:ZenDateTimePicker
                        x:Name="ConstrainedDateTimePicker"
                        Width="280"
                        HorizontalAlignment="Left"
                        MinuteIncrement="15"
                        Watermark="选择预约时间" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="日历行为" />
                    <TextBlock Style="{StaticResource GallerySectionDescriptionStyle}" Text="可设置一周的起始日，并按业务需要关闭今日高亮。" />
                    <WrapPanel>
                        <StackPanel Width="280" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="周一为首日" />
                            <zen:ZenDateTimePicker
                                x:Name="MondayFirstPicker"
                                Width="260"
                                FirstDayOfWeek="Monday"
                                Watermark="打开日历查看" />
                        </StackPanel>
                        <StackPanel Width="280" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="不突出今天" />
                            <zen:ZenDateTimePicker
                                x:Name="WithoutTodayHighlightPicker"
                                Width="260"
                                IsTodayHighlighted="False"
                                Watermark="打开日历查看" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="弹层布局" />
                    <TextBlock Style="{StaticResource GallerySectionDescriptionStyle}" Text="分别设置日历单元与时间项的尺寸，弹层会按内容自然测量；本例使用等高但不同宽度的日期与时间选项。" />
                    <WrapPanel>
                        <StackPanel Width="320" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="自然测量 · 自定义单元" />
                            <zen:ZenDateTimePicker
                                x:Name="NaturalMetricsPicker"
                                Width="300"
                                HorizontalAlignment="Left"
                                CalendarCellHeight="44"
                                CalendarCellWidth="52"
                                CornerRadius="12"
                                DropDownButtonIconSize="20"
                                IsSecondVisible="True"
                                TimeItemHeight="44"
                                TimeItemWidth="70" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                        <zen:ZenSwitch
                            x:Name="DateTimeDropDownSwitch"
                            Margin="0,0,18,0"
                            CheckedContent="开"
                            UncheckedContent="关" />
                        <zen:ZenDateTimePicker
                            Width="300"
                            DropDownHeight="480"
                            DropDownWidth="680"
                            IsDropDownOpen="{Binding IsChecked, ElementName=DateTimeDropDownSwitch, Mode=TwoWay}"
                            Watermark="固定 680 × 480 弹层" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="变更事件" />
                    <TextBlock Style="{StaticResource GallerySectionDescriptionStyle}" Text="SelectedDateTimeChanged 会在确认新值后通知业务代码。" />
                    <WrapPanel VerticalAlignment="Center">
                        <zen:ZenDateTimePicker
                            Width="280"
                            Margin="0,0,18,0"
                            HorizontalAlignment="Left"
                            SelectedDateTimeChanged="DateTimePicker_OnSelectedDateTimeChanged"
                            Watermark="选择后查看事件结果" />
                        <TextBlock
                            x:Name="DateTimeChangedStatus"
                            MaxWidth="320"
                            VerticalAlignment="Center"
                            Style="{StaticResource GallerySupportingTextStyle}"
                            Text="尚未触发 SelectedDateTimeChanged。" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <gallery:PropertyTable ControlType="{x:Type zen:ZenDateTimePicker}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

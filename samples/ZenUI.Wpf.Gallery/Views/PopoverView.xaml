<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.PopoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <UserControl.Resources>
        <Style
            x:Key="GalleryTextAnchorButtonStyle"
            BasedOn="{StaticResource ZenPopoverAnchorButtonStyle}"
            TargetType="{x:Type ToggleButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="{DynamicResource ZenFontWeightSemibold}" />
            <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="Popover 气泡提示" Description="通过点击锚点显示轻量补充信息；既可直接使用默认问号，也可完整替换锚点和浮层内容。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="默认锚点" />
                    <TextBlock
                        Margin="0,8,0,16"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="未设置 Anchor 时，控件提供圆圈加问号的默认入口。" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenPopover Margin="0,0,28,0">
                            <TextBlock
                                Width="260"
                                Text="默认锚点适合字段说明、规则解释和不需要长期占据界面的辅助信息。"
                                TextWrapping="Wrap" />
                        </zen:ZenPopover>
                        <zen:ZenPopover Placement="Bottom">
                            <StackPanel Width="240">
                                <TextBlock FontWeight="{DynamicResource ZenFontWeightSemibold}" Text="库存预警" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                    Text="库存低于安全数量时，系统会在商品列表中显示预警状态。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </zen:ZenPopover>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="自定义锚点" />
                    <TextBlock
                        Margin="0,8,0,16"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="设置 Anchor 后将完整呈现指定内容，不再附加默认圆圈或问号。" />
                    <WrapPanel>
                        <zen:ZenPopover
                            Margin="0,0,32,12"
                            Anchor="查看帮助"
                            AnchorButtonStyle="{StaticResource GalleryTextAnchorButtonStyle}">
                            <TextBlock
                                Width="220"
                                Text="文字链接可以作为轻量锚点，并继续保留键盘和点击操作。"
                                TextWrapping="Wrap" />
                        </zen:ZenPopover>

                        <zen:ZenPopover Margin="0,0,32,12" Placement="Bottom">
                            <zen:ZenPopover.Anchor>
                                <Border
                                    Height="28"
                                    MinWidth="28"
                                    Padding="8,0"
                                    Background="{DynamicResource ZenInfoLightBrush}"
                                    CornerRadius="14">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="{DynamicResource ZenFontWeightSemibold}"
                                        Foreground="{DynamicResource ZenPrimaryBrush}"
                                        Text="3 条更新" />
                                </Border>
                            </zen:ZenPopover.Anchor>
                            <StackPanel Width="220">
                                <TextBlock FontWeight="{DynamicResource ZenFontWeightSemibold}" Text="最近更新" />
                                <TextBlock Margin="0,8,0,0" Text="• 新增批量导出能力" />
                                <TextBlock Margin="0,4,0,0" Text="• 优化高对比度主题" />
                                <TextBlock Margin="0,4,0,0" Text="• 修复键盘焦点反馈" />
                            </StackPanel>
                        </zen:ZenPopover>

                        <zen:ZenPopover Margin="0,0,32,12" Placement="Right">
                            <zen:ZenPopover.Anchor>
                                <Border
                                    Padding="10,5"
                                    Background="{DynamicResource ZenSuccessLightBrush}"
                                    CornerRadius="14">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource ZenSuccessBrush}" />
                                        <TextBlock Foreground="{DynamicResource ZenSuccessBrush}" Text="服务正常" />
                                    </StackPanel>
                                </Border>
                            </zen:ZenPopover.Anchor>
                            <TextBlock Text="所有服务均正常运行。" />
                        </zen:ZenPopover>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="显示方向" />
                    <TextBlock
                        Margin="0,8,0,16"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="Popover 相对于 Anchor 定位，并自动将箭头放在对应方向。" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenPopover
                            Margin="0,0,32,0"
                            Anchor="↑ 上方"
                            AnchorButtonStyle="{StaticResource GalleryTextAnchorButtonStyle}"
                            Content="显示在锚点上方"
                            Placement="Top" />
                        <zen:ZenPopover
                            Margin="0,0,32,0"
                            Anchor="↓ 下方"
                            AnchorButtonStyle="{StaticResource GalleryTextAnchorButtonStyle}"
                            Content="显示在锚点下方"
                            Placement="Bottom" />
                        <zen:ZenPopover
                            Margin="0,0,32,0"
                            Anchor="← 左侧"
                            AnchorButtonStyle="{StaticResource GalleryTextAnchorButtonStyle}"
                            Content="显示在锚点左侧"
                            Placement="Left" />
                        <zen:ZenPopover
                            Anchor="→ 右侧"
                            AnchorButtonStyle="{StaticResource GalleryTextAnchorButtonStyle}"
                            Content="显示在锚点右侧"
                            Placement="Right" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="业务内容" />
                    <TextBlock
                        Margin="0,8,0,16"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="浮层内容支持任意 WPF 元素，包括布局、数据绑定和可交互控件。" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenPopover
                            Margin="0,0,40,0"
                            Padding="14,12"
                            Placement="Top">
                            <zen:ZenPopover.Anchor>
                                <TextBlock FontSize="18" Text="🔊" />
                            </zen:ZenPopover.Anchor>
                            <StackPanel Width="36">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                    Text="音量" />
                                <zen:ZenSlider
                                    x:Name="volumeSlider"
                                    Height="150"
                                    IsSnapToTickEnabled="True"
                                    Maximum="100"
                                    Minimum="0"
                                    Orientation="Vertical"
                                    TickFrequency="1"
                                    Value="30" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    FontWeight="{DynamicResource ZenFontWeightSemibold}"
                                    Text="{Binding ElementName=volumeSlider, Path=Value, StringFormat={}{0}%}" />
                            </StackPanel>
                        </zen:ZenPopover>

                        <zen:ZenPopover Placement="Bottom">
                            <zen:ZenPopover.Anchor>
                                <Border
                                    Padding="12,7"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource ZenBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <TextBlock Text="快捷键" />
                                </Border>
                            </zen:ZenPopover.Anchor>
                            <Grid Width="230">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="{DynamicResource ZenFontWeightSemibold}" Text="常用操作" />
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,10,20,0"
                                    Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                    Text="保存当前内容" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    Text="Ctrl + S" />
                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,6,20,0"
                                    Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                    Text="关闭浮层" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,6,0,0"
                                    Text="Esc" />
                            </Grid>
                        </zen:ZenPopover>

                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="浮层外观" />
                    <TextBlock
                        Margin="0,8,0,16"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="背景、边框、圆角、内边距、宽度和箭头均可独立调整。" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenPopover
                            Margin="0,0,32,0"
                            Padding="18,12"
                            Background="{DynamicResource ZenWarningLightBrush}"
                            BorderBrush="{DynamicResource ZenWarningBrush}"
                            CornerRadius="12"
                            MaxPopupWidth="280">
                            <TextBlock
                                Width="220"
                                Text="使用状态色时仍应保证内容清晰，并避免大面积高饱和颜色。"
                                TextWrapping="Wrap" />
                        </zen:ZenPopover>
                        <zen:ZenPopover
                            Padding="12,8"
                            Anchor="无箭头浮层"
                            AnchorButtonStyle="{StaticResource GalleryTextAnchorButtonStyle}"
                            Background="{DynamicResource ZenSurfaceMutedBrush}"
                            BorderThickness="0"
                            Content="适合不需要强调指向关系的轻量内容。"
                            CornerRadius="10"
                            ShowArrow="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <gallery:PropertyTable ControlType="{x:Type zen:ZenPopover}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

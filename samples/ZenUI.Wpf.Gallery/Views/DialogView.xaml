<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.DialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader
                Title="Dialog 对话框"
                Description="Prism 弹窗由统一宿主自动应用 ZenUI 外观，仍可按需调整尺寸和操作按钮。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="按钮组合与窗口尺寸" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="对比默认 440 × 240、紧凑 380 × 220 和较大 600 × 320 的弹窗；最后一种同时演示隐藏底部操作区与禁止拖动。" />
                    <WrapPanel>
                        <zen:ZenButton
                            Command="{Binding ShowDialogCommand}"
                            Content="双按钮 · 默认 440 × 240"
                            Style="{StaticResource GalleryButtonStyle}" />
                        <zen:ZenButton
                            Command="{Binding ShowConfirmOnlyCommand}"
                            Content="仅确定 · 380 × 220"
                            Style="{StaticResource GalleryButtonStyle}" />
                        <zen:ZenButton
                            Command="{Binding ShowCancelOnlyCommand}"
                            Content="仅取消 · 600 × 320"
                            Style="{StaticResource GalleryButtonStyle}" />
                        <zen:ZenButton
                            Command="{Binding ShowContentOnlyCommand}"
                            Content="无按钮 · 不可拖动"
                            Style="{StaticResource GalleryButtonStyle}" />
                    </WrapPanel>
                    <zen:ZenAlert
                        Margin="0,16,0,0"
                        Content="{Binding ResultMessage}"
                        Severity="Info" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="遮罩弹窗" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="遮罩窗口与主窗口同位置、同大小；半透明遮罩内的弹窗内容固定居中。本示例将内容面板设为 680 × 400，打开期间不能操作主窗口。" />
                    <zen:ZenButton
                        HorizontalAlignment="Left"
                        Command="{Binding ShowOverlayCommand}"
                        Content="打开遮罩弹窗"
                        Style="{StaticResource GalleryButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="非模态弹窗" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="使用 Prism 的 Show 打开，弹窗显示时主窗口仍可操作。可先把弹窗拖到一旁，再点击下面的计数按钮；上方示例使用 ShowDialog，打开时主窗口无法操作。" />
                    <WrapPanel>
                        <zen:ZenButton
                            Command="{Binding ShowNonModalCommand}"
                            Content="打开非模态弹窗"
                            Style="{StaticResource GalleryButtonStyle}" />
                        <zen:ZenButton
                            Command="{Binding IncrementCounterCommand}"
                            Content="主窗口计数 +1"
                            Style="{StaticResource GalleryButtonStyle}" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="{Binding MainWindowClickCount, StringFormat=主窗口已点击 {0} 次}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="统一样式与单个弹窗自定义" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="Gallery 已注册统一的 Prism 弹窗宿主；默认双按钮和非模态示例没有声明 WindowStyle，也会自动使用 ZenDialogWindowStyle。" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="只调整某个弹窗时，在该视图的 prism:Dialog.WindowStyle 中声明 Style，并用 BasedOn 继承 ZenDialogWindowStyle；仅确定、仅取消和无按钮示例分别覆盖了自己的设置，不会影响其他弹窗。" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="ShowConfirmButton / ShowCancelButton：分别控制两个按钮；都为 False 时自动隐藏整个底部操作区。" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="ConfirmContent / CancelContent：分别设置按钮文案，本页示例使用“知道了”和“返回”。" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="ContentMargin / FooterPadding：分别调整正文外边距与底部操作区内边距；仅确定和仅取消示例分别设置了这两个选项。" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="ConfirmCommand / CancelCommand：在弹窗视图根元素绑定任意名称的 ViewModel 命令；本页绑定 SaveCommand 和 DiscardCommand，由 Prism 返回结果。" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="IsDraggable：控制能否按住标题栏移动窗口，默认 True；“无按钮 · 不可拖动”示例设为 False。" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="窗口宽高：需要覆盖时，在对应视图的 Dialog.WindowStyle 中设置 Width 和 Height；未设置时使用 440 × 240。标题由该弹窗的 IDialogAware.Title 提供。" />
                    <TextBlock
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="可在页面顶部切换浅色、深色、高对比度主题及界面密度后再次打开。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

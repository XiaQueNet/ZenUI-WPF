<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.ComboBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:local="clr-namespace:ZenUI.Wpf.Gallery.Views"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="ComboBox 下拉框" Description="用于从较长的候选列表中选择一个选项。" />
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本用法与状态" />
                    <WrapPanel>
                        <zen:ZenComboBox
                            Width="240"
                            Margin="{StaticResource GalleryFieldMargin}"
                            Watermark="请选择城市">
                            <ComboBoxItem Content="北京" />
                            <ComboBoxItem Content="上海" />
                            <ComboBoxItem Content="深圳" />
                            <ComboBoxItem Content="成都" />
                        </zen:ZenComboBox>
                        <zen:ZenComboBox
                            Width="240"
                            Margin="{StaticResource GalleryFieldMargin}"
                            SelectedIndex="1">
                            <ComboBoxItem Content="普通用户" />
                            <ComboBoxItem Content="管理员" />
                            <ComboBoxItem Content="访客" />
                        </zen:ZenComboBox>
                        <zen:ZenComboBox
                            Width="180"
                            Margin="{StaticResource GalleryFieldMargin}"
                            IsEnabled="False"
                            Watermark="禁用状态" />
                        <zen:ZenComboBox
                            Width="180"
                            Margin="{StaticResource GalleryFieldMargin}"
                            Background="{StaticResource ZenDataGridRowHoverBrush}"
                            BorderBrush="{StaticResource ZenDataGridRowHoverBrush}"
                            Watermark="请选择城市">
                            <ComboBoxItem Content="北京" />
                            <ComboBoxItem Content="上海" />
                            <ComboBoxItem Content="深圳" />
                            <ComboBoxItem Content="成都" />
                        </zen:ZenComboBox>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="圆角" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="直角" />
                            <zen:ZenComboBox
                                Width="220"
                                CornerRadius="0"
                                SelectedIndex="0">
                                <ComboBoxItem Content="设计" />
                                <ComboBoxItem Content="开发" />
                                <ComboBoxItem Content="测试" />
                            </zen:ZenComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="默认圆角" />
                            <zen:ZenComboBox
                                Width="220"
                                CornerRadius="6"
                                SelectedIndex="1">
                                <ComboBoxItem Content="设计" />
                                <ComboBoxItem Content="开发" />
                                <ComboBoxItem Content="测试" />
                            </zen:ZenComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="大圆角" />
                            <zen:ZenComboBox
                                Width="220"
                                CornerRadius="18"
                                SelectedIndex="2">
                                <ComboBoxItem Content="设计" />
                                <ComboBoxItem Content="开发" />
                                <ComboBoxItem Content="测试" />
                            </zen:ZenComboBox>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="尺寸" />
                    <WrapPanel VerticalAlignment="Bottom">
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="紧凑 · 32px" />
                            <zen:ZenComboBox
                                Width="200"
                                Height="32"
                                SelectedIndex="0">
                                <ComboBoxItem Content="小尺寸" />
                                <ComboBoxItem Content="其他选项" />
                            </zen:ZenComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="默认 · 36px" />
                            <zen:ZenComboBox
                                Width="220"
                                Height="36"
                                SelectedIndex="0">
                                <ComboBoxItem Content="默认尺寸" />
                                <ComboBoxItem Content="其他选项" />
                            </zen:ZenComboBox>
                        </StackPanel>
                        <StackPanel Width="240" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="宽松 · 44px" />
                            <zen:ZenComboBox
                                Width="240"
                                Height="44"
                                SelectedIndex="0">
                                <ComboBoxItem Content="大尺寸" />
                                <ComboBoxItem Content="其他选项" />
                            </zen:ZenComboBox>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="长列表" />
                    <TextBlock Style="{StaticResource GallerySectionDescriptionStyle}" Text="通过 MaxDropDownHeight 限制面板高度，超出后可滚动浏览。" />
                    <zen:ZenComboBox
                        Width="320"
                        HorizontalAlignment="Left"
                        MaxDropDownHeight="150"
                        Watermark="请选择时区">
                        <ComboBoxItem Content="(UTC-08:00) 太平洋时间" />
                        <ComboBoxItem Content="(UTC-05:00) 东部时间" />
                        <ComboBoxItem Content="(UTC+00:00) 格林尼治标准时间" />
                        <ComboBoxItem Content="(UTC+01:00) 中欧时间" />
                        <ComboBoxItem Content="(UTC+05:30) 印度标准时间" />
                        <ComboBoxItem Content="(UTC+08:00) 中国标准时间" />
                        <ComboBoxItem Content="(UTC+09:00) 日本标准时间" />
                        <ComboBoxItem Content="(UTC+10:00) 澳大利亚东部时间" />
                    </zen:ZenComboBox>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="枚举集合绑定" />
                    <TextBlock Style="{StaticResource GallerySectionDescriptionStyle}" Text="通过 ItemsSource 直接绑定 Enum.GetValues 返回的订单状态集合。" />
                    <StackPanel Orientation="Horizontal">
                        <zen:ZenComboBox
                            x:Name="OrderStatusComboBox"
                            Width="240"
                            ItemsSource="{Binding OrderStatuses, RelativeSource={RelativeSource AncestorType={x:Type local:ComboBoxView}}}"
                            SelectedIndex="1" />
                        <TextBlock
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource GallerySupportingTextStyle}"
                            Text="{Binding SelectedItem, ElementName=OrderStatusComboBox, StringFormat=当前选中：{0}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <gallery:PropertyTable ControlType="{x:Type zen:ZenComboBox}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

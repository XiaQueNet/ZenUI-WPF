<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.TokenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="40"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="设计 Token 与 Density" Description="查看六层公开 Token 在当前主题与密度下的解析值，并实时检查控件的颜色、尺寸与间距。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="当前密度预览" />
                    <TextBlock
                        Margin="0,0,0,18"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="使用窗口左下角切换浅色、深色、高对比度主题，或紧凑、标准、宽松密度；下面的控件及 Token 值会立即更新。" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="输入与操作" />
                            <zen:ZenTextBox Margin="0,0,0,10" Watermark="输入控件高度与内边距" />
                            <zen:ZenNumberBox
                                Margin="0,0,0,10"
                                Maximum="10"
                                Minimum="0"
                                Step="0.5"
                                Value="2.5" />
                            <zen:ZenComboBox Margin="0,0,0,10" SelectedIndex="0">
                                <ComboBoxItem Content="下拉弹层尺寸" />
                                <ComboBoxItem Content="第二项" />
                            </zen:ZenComboBox>
                            <StackPanel Orientation="Horizontal">
                                <zen:ZenButton Width="80" Content="按钮" />
                                <zen:ZenSwitch Margin="16,0,0,0" IsChecked="True" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="反馈与选择" />
                            <zen:ZenDatePicker Margin="0,0,0,10" SelectedDate="2026-07-23" />
                            <zen:ZenSlider Margin="0,0,0,10" Value="62" />
                            <zen:ZenProgressBar Margin="0,0,0,10" Value="62" />
                            <zen:ZenAlert Content="Alert 内边距随密度更新" Severity="Success" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock
                        Margin="0,22,0,10"
                        Style="{StaticResource GalleryFieldLabelStyle}"
                        Text="复合控件" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="DataGrid 的表头、行高与单元格内边距会随 Density 更新。" />
                            <zen:ZenDataGrid
                                x:Name="DensityDataGrid"
                                Height="220"
                                AutoGenerateColumns="False"
                                IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        Header="Token 范围" />
                                    <DataGridTextColumn
                                        Width="210"
                                        Binding="{Binding Description}"
                                        Header="当前行为" />
                                </DataGrid.Columns>
                            </zen:ZenDataGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="Calendar 的整体、日期格与导航按钮尺寸会同步变化。" />
                            <zen:ZenCalendar
                                HorizontalAlignment="Left"
                                DisplayDate="2026-07-01"
                                SelectedDate="2026-07-27" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock
                Margin="0,4,0,18"
                Style="{StaticResource GallerySupportingTextStyle}"
                Text="以下目录按语义颜色、组件颜色、排版、基础尺寸、组件尺寸和交互状态分层列出；显示的是当前资源树最终解析后的值。" />
            <StackPanel x:Name="TokenSections" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

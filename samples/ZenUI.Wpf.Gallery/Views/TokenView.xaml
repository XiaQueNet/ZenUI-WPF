<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.TokenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <UserControl.Resources>
        <Style x:Key="TokenSupportingTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBodySmall}" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TokenEyebrowStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ZenPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeCaption}" />
            <Setter Property="FontWeight" Value="{DynamicResource ZenFontWeightSemibold}" />
        </Style>

        <Style x:Key="TokenCodeStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TokenArchitectureItemStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="0,16,24,22" />
            <Setter Property="BorderBrush" Value="{DynamicResource ZenDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <Style x:Key="TokenArchitectureTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource ZenTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
            <Setter Property="FontWeight" Value="{DynamicResource ZenFontWeightSemibold}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader
                Title="设计 Token 与 Density"
                Description="理解六层公开 Token 如何从设计语义解析为组件外观，并实时检查主题、尺寸、间距与交互状态。" />

            <!--  A quiet introduction replaces the former dashboard-style hero.  -->
            <Border
                Margin="0,0,0,40"
                Padding="28"
                Background="{DynamicResource ZenSurfaceMutedBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TokenEyebrowStyle}" Text="DESIGN TOKEN SYSTEM" />
                        <TextBlock
                            MaxWidth="520"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            FontSize="24"
                            FontWeight="{DynamicResource ZenFontWeightSemibold}"
                            Foreground="{DynamicResource ZenTextPrimaryBrush}"
                            LineHeight="34"
                            Text="一个资源入口，驱动一致体验"
                            TextWrapping="Wrap" />
                        <TextBlock
                            MaxWidth="560"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource TokenSupportingTextStyle}"
                            Text="语义资源将主题与组件解耦；Density Token 让输入、列表、表格和日历在三档密度间保持协调。" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,10"
                            Style="{StaticResource TokenEyebrowStyle}"
                            Text="运行时解析链路" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="01  基础值" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource TokenCodeStyle}"
                                Text="Metrics" />
                        </DockPanel>
                        <Border
                            Margin="0,0,0,8"
                            BorderBrush="{DynamicResource ZenDividerBrush}"
                            BorderThickness="0,1,0,0" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="02  语义映射" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource TokenCodeStyle}"
                                Text="Semantic" />
                        </DockPanel>
                        <Border
                            Margin="0,0,0,8"
                            BorderBrush="{DynamicResource ZenDividerBrush}"
                            BorderThickness="0,1,0,0" />
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Left"
                                FontWeight="{DynamicResource ZenFontWeightSemibold}"
                                Text="03  组件资源" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource TokenCodeStyle}"
                                Text="Resolved" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Live token lab.  -->
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="实时 Token 实验台" />
                    <TextBlock
                        Margin="0,0,0,22"
                        Style="{StaticResource TokenSupportingTextStyle}"
                        Text="使用左侧设置切换主题与密度；控件及资源样本会同步更新。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource TokenEyebrowStyle}" Text="组件预览" />
                            <TextBlock
                                Margin="0,5,0,18"
                                Style="{StaticResource TokenSupportingTextStyle}"
                                Text="观察高度、内边距、圆角与状态反馈。" />

                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="输入与选择" />
                            <zen:ZenTextBox
                                Margin="0,0,0,10"
                                AutomationProperties.Name="Token 输入预览"
                                Watermark="输入控件高度与内边距" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <zen:ZenNumberBox
                                    Maximum="10"
                                    Minimum="0"
                                    Step="0.5"
                                    Value="2.5" />
                                <zen:ZenComboBox Grid.Column="2" SelectedIndex="0">
                                    <ComboBoxItem Content="标准尺寸" />
                                    <ComboBoxItem Content="紧凑尺寸" />
                                    <ComboBoxItem Content="宽松尺寸" />
                                </zen:ZenComboBox>
                            </Grid>
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="连续数值与操作" />
                            <zen:ZenSlider
                                Margin="0,0,0,12"
                                AutomationProperties.Name="Token 滑块预览"
                                Value="62" />
                            <WrapPanel>
                                <zen:ZenButton Content="主要操作" Style="{StaticResource GalleryButtonStyle}" />
                                <zen:ZenButton
                                    Appearance="Text"
                                    Content="次要操作"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Neutral" />
                                <zen:ZenSwitch
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Token 开关预览"
                                    IsChecked="True" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource TokenEyebrowStyle}" Text="资源检查器" />
                            <TextBlock
                                Margin="0,5,0,18"
                                Style="{StaticResource TokenSupportingTextStyle}"
                                Text="查看语义资源在当前主题下的视觉结果。" />

                            <Border
                                Padding="20"
                                Background="{DynamicResource ZenSurfaceMutedBrush}"
                                CornerRadius="6">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Border
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource ZenPrimaryBrush}"
                                            CornerRadius="5"
                                            DockPanel.Dock="Left" />
                                        <StackPanel>
                                            <TextBlock FontWeight="{DynamicResource ZenFontWeightSemibold}" Text="Primary" />
                                            <TextBlock Style="{StaticResource TokenCodeStyle}" Text="ZenPrimaryBrush" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Border
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource ZenSurfaceBrush}"
                                            BorderBrush="{DynamicResource ZenDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            DockPanel.Dock="Left" />
                                        <StackPanel>
                                            <TextBlock FontWeight="{DynamicResource ZenFontWeightSemibold}" Text="Surface" />
                                            <TextBlock Style="{StaticResource TokenCodeStyle}" Text="ZenSurfaceBrush" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel>
                                        <Border
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource ZenTextPrimaryBrush}"
                                            CornerRadius="5"
                                            DockPanel.Dock="Left" />
                                        <StackPanel>
                                            <TextBlock FontWeight="{DynamicResource ZenFontWeightSemibold}" Text="Text Primary" />
                                            <TextBlock Style="{StaticResource TokenCodeStyle}" Text="ZenTextPrimaryBrush" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <zen:ZenAlert Margin="0,12,0,0" Severity="Success">
                                <TextBlock Text="资源树已解析，当前控件状态正常。" TextWrapping="Wrap" />
                            </zen:ZenAlert>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Density and complex controls.  -->
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Density 如何影响复合控件" />
                    <TextBlock
                        Margin="0,0,0,22"
                        Style="{StaticResource TokenSupportingTextStyle}"
                        Text="Density 会同步调整列表、弹层、表格和日期网格，使整套界面的信息密度保持一致。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontWeight="{DynamicResource ZenFontWeightSemibold}"
                                Text="影响范围" />
                            <TextBlock
                                Margin="0,0,0,14"
                                Style="{StaticResource TokenSupportingTextStyle}"
                                Text="表头、行高与单元格内边距实时更新。" />
                            <zen:ZenDataGrid
                                x:Name="DensityDataGrid"
                                Height="226"
                                AutoGenerateColumns="False"
                                IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        Header="Token 范围" />
                                    <DataGridTextColumn
                                        Width="190"
                                        Binding="{Binding Description}"
                                        Header="当前行为" />
                                </DataGrid.Columns>
                            </zen:ZenDataGrid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontWeight="{DynamicResource ZenFontWeightSemibold}"
                                Text="Calendar 尺寸预览" />
                            <TextBlock
                                Margin="0,0,0,14"
                                Style="{StaticResource TokenSupportingTextStyle}"
                                Text="日期格、导航按钮与整体尺寸同步变化。" />
                            <zen:ZenCalendar
                                HorizontalAlignment="Left"
                                DisplayDate="2026-07-01"
                                SelectedDate="2026-07-29" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Architecture uses typographic hierarchy and dividers instead of cards.  -->
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="六层 Token 架构" />
                    <TextBlock
                        Margin="0,0,0,14"
                        Style="{StaticResource TokenSupportingTextStyle}"
                        Text="从设计语义到组件实现，每一层职责独立，并可通过 DynamicResource 在运行时重新解析。" />
                    <UniformGrid Columns="3" Rows="2">
                        <Border Style="{StaticResource TokenArchitectureItemStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TokenEyebrowStyle}" Text="01" />
                                <TextBlock Style="{StaticResource TokenArchitectureTitleStyle}" Text="语义颜色" />
                                <TextBlock Style="{StaticResource TokenSupportingTextStyle}" Text="品牌、表面、文本与状态语义。" />
                                <TextBlock Margin="0,9,0,0" Style="{StaticResource TokenCodeStyle}" Text="SemanticColors.xaml" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TokenArchitectureItemStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TokenEyebrowStyle}" Text="02" />
                                <TextBlock Style="{StaticResource TokenArchitectureTitleStyle}" Text="组件颜色" />
                                <TextBlock Style="{StaticResource TokenSupportingTextStyle}" Text="控件背景、边框与前景映射。" />
                                <TextBlock Margin="0,9,0,0" Style="{StaticResource TokenCodeStyle}" Text="ComponentColors.xaml" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TokenArchitectureItemStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TokenEyebrowStyle}" Text="03" />
                                <TextBlock Style="{StaticResource TokenArchitectureTitleStyle}" Text="排版" />
                                <TextBlock Style="{StaticResource TokenSupportingTextStyle}" Text="字号、字重与行高层级。" />
                                <TextBlock Margin="0,9,0,0" Style="{StaticResource TokenCodeStyle}" Text="Typography.xaml" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TokenArchitectureItemStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TokenEyebrowStyle}" Text="04" />
                                <TextBlock Style="{StaticResource TokenArchitectureTitleStyle}" Text="基础尺寸" />
                                <TextBlock Style="{StaticResource TokenSupportingTextStyle}" Text="间距、圆角、边框与通用尺寸。" />
                                <TextBlock Margin="0,9,0,0" Style="{StaticResource TokenCodeStyle}" Text="Metrics.xaml" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TokenArchitectureItemStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TokenEyebrowStyle}" Text="05" />
                                <TextBlock Style="{StaticResource TokenArchitectureTitleStyle}" Text="组件尺寸" />
                                <TextBlock Style="{StaticResource TokenSupportingTextStyle}" Text="各密度下的组件高度与内边距。" />
                                <TextBlock Margin="0,9,0,0" Style="{StaticResource TokenCodeStyle}" Text="ComponentMetrics.xaml" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TokenArchitectureItemStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TokenEyebrowStyle}" Text="06" />
                                <TextBlock Style="{StaticResource TokenArchitectureTitleStyle}" Text="交互状态" />
                                <TextBlock Style="{StaticResource TokenSupportingTextStyle}" Text="悬停、按下、焦点与禁用反馈。" />
                                <TextBlock Margin="0,9,0,0" Style="{StaticResource TokenCodeStyle}" Text="Interaction.xaml" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!--  Dynamically generated token directory.  -->
            <Border
                Margin="0,0,0,30"
                Padding="18,14"
                Background="{DynamicResource ZenSurfaceMutedBrush}"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        FontWeight="{DynamicResource ZenFontWeightSemibold}"
                        Foreground="{DynamicResource ZenTextPrimaryBrush}"
                        Text="当前资源解析目录" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource TokenSupportingTextStyle}"
                        Text="以下按六个源文件分组，展示当前资源树最终解析后的 Key、值和颜色样本。" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="TokenSections" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

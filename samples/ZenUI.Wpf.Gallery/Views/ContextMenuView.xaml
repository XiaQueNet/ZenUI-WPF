<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.ContextMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="ContextMenu 右键菜单" Description="承载与当前对象相关的轻量命令，支持图标、快捷键、勾选状态与级联菜单。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本用法" />
                    <TextBlock
                        Margin="0,0,0,14"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="在下方文件卡片上单击右键。" />
                    <Border
                        Width="420"
                        Padding="20"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ZenSurfaceMutedBrush}"
                        BorderBrush="{DynamicResource ZenBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.ContextMenu>
                            <zen:ZenContextMenu>
                                <zen:ZenMenuItem
                                    Click="OpenWebsite_Click"
                                    Header="打开"
                                    InputGestureText="Enter">
                                    <zen:ZenMenuItem.Icon>
                                        <Viewbox Width="16" Height="16">
                                            <Path
                                                Data="M2,3.5 H6 L7.5,5 H14 V13.5 H2 Z M2,7 H14"
                                                Stroke="{DynamicResource ZenTextSecondaryBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </Viewbox>
                                    </zen:ZenMenuItem.Icon>
                                </zen:ZenMenuItem>
                                <zen:ZenMenuItem Header="重命名" InputGestureText="F2">
                                    <zen:ZenMenuItem.Icon>
                                        <Viewbox Width="16" Height="16">
                                            <Path
                                                Data="M3,11.75 L2.5,14 L4.75,13.5 L13.35,4.9 C13.9,4.35 13.9,3.45 13.35,2.9 L13.1,2.65 C12.55,2.1 11.65,2.1 11.1,2.65 Z M9.9,3.85 L12.15,6.1"
                                                Stroke="{DynamicResource ZenTextSecondaryBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </Viewbox>
                                    </zen:ZenMenuItem.Icon>
                                </zen:ZenMenuItem>
                                <zen:ZenMenuItem Header="共享">
                                    <zen:ZenMenuItem.Icon>
                                        <Viewbox Width="16" Height="16">
                                            <Path
                                                Data="M5.1,8.9 L10.9,12.1 M10.9,3.9 L5.1,7.1 M3.5,10 A2,2 0 1 0 3.5,6 A2,2 0 1 0 3.5,10 M12.5,5 A2,2 0 1 0 12.5,1 A2,2 0 1 0 12.5,5 M12.5,15 A2,2 0 1 0 12.5,11 A2,2 0 1 0 12.5,15"
                                                Stroke="{DynamicResource ZenTextSecondaryBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </Viewbox>
                                    </zen:ZenMenuItem.Icon>
                                    <zen:ZenMenuItem Click="CopyLink_Click" Header="复制链接" />
                                    <zen:ZenMenuItem Header="发送副本" />
                                    <zen:ZenMenuItem Header="管理访问权限" />
                                </zen:ZenMenuItem>
                                <Separator />
                                <zen:ZenMenuItem
                                    Header="固定到快速访问"
                                    IsCheckable="True"
                                    IsChecked="True"
                                    StaysOpenOnClick="True" />
                                <zen:ZenMenuItem Header="仅云端可用" IsEnabled="False" />
                                <Separator />
                                <zen:ZenMenuItem
                                    Foreground="{DynamicResource ZenErrorBrush}"
                                    Header="删除"
                                    InputGestureText="Delete">
                                    <zen:ZenMenuItem.Icon>
                                        <Viewbox Width="16" Height="16">
                                            <Path
                                                Data="M2.5,4.5 H13.5 M6,2.5 H10 M4.5,4.5 L5.1,14 H10.9 L11.5,4.5 M6.75,7 V11.5 M9.25,7 V11.5"
                                                Stroke="{DynamicResource ZenErrorBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </Viewbox>
                                    </zen:ZenMenuItem.Icon>
                                </zen:ZenMenuItem>
                            </zen:ZenContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="34"
                                Height="42"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ZenInfoLightBrush}"
                                CornerRadius="4">
                                <Viewbox
                                    Width="18"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Path
                                        Data="M3,1 H12 L17,6 V21 H3 Z M12,1 V6 H17 M6.5,11 H13.5 M6.5,15 H13.5"
                                        Stroke="{DynamicResource ZenInfoBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.5" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="ZenUI 设计规范.pdf" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource GallerySupportingTextStyle}"
                                    Text="2.4 MB · 今天 10:24 更新" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock
                        x:Name="ActionFeedback"
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource ZenSuccessBrush}"
                        Text="链接已复制到剪贴板"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="按钮触发" />
                    <TextBlock
                        Margin="0,0,0,14"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="同一个 ContextMenu 既可以响应右键，也可以由按钮单击后在按钮下方打开。" />
                    <zen:ZenButton HorizontalAlignment="Left" Click="OpenButtonMenu_Click">
                        <zen:ZenButton.ContextMenu>
                            <zen:ZenContextMenu Placement="Bottom">
                                <zen:ZenMenuItem Click="OpenWebsite_Click" Header="访问 ZenUI 官网">
                                    <zen:ZenMenuItem.Icon>
                                        <Viewbox Width="16" Height="16">
                                            <Path
                                                Data="M2.5,8 A5.5,5.5 0 1 0 13.5,8 A5.5,5.5 0 1 0 2.5,8 M2.75,8 H13.25 M8,2.5 C10.6,5.45 10.6,10.55 8,13.5 M8,2.5 C5.4,5.45 5.4,10.55 8,13.5"
                                                Stroke="{DynamicResource ZenTextSecondaryBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </Viewbox>
                                    </zen:ZenMenuItem.Icon>
                                </zen:ZenMenuItem>
                                <zen:ZenMenuItem Click="CopyLink_Click" Header="复制官网链接">
                                    <zen:ZenMenuItem.Icon>
                                        <Viewbox Width="16" Height="16">
                                            <Path
                                                Data="M6.25,9.75 L9.75,6.25 M5.1,11.65 L3.95,12.8 C2.9,13.85 1.2,13.85 0.15,12.8 C-0.9,11.75 -0.9,10.05 0.15,9 L3.4,5.75 C4.45,4.7 6.15,4.7 7.2,5.75 M8.8,10.25 C9.85,11.3 11.55,11.3 12.6,10.25 L15.85,7 C16.9,5.95 16.9,4.25 15.85,3.2 C14.8,2.15 13.1,2.15 12.05,3.2 L10.9,4.35"
                                                Stroke="{DynamicResource ZenTextSecondaryBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </Viewbox>
                                    </zen:ZenMenuItem.Icon>
                                </zen:ZenMenuItem>
                            </zen:ZenContextMenu>
                        </zen:ZenButton.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Text="更多" />
                            <Path
                                Width="10"
                                Height="6"
                                VerticalAlignment="Center"
                                Data="M 1,1 L 5,5 L 9,1"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenButton}}}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5" />
                        </StackPanel>
                    </zen:ZenButton>
                </StackPanel>
            </Border>

            <gallery:PropertyTable ControlType="{x:Type zen:ZenContextMenu}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

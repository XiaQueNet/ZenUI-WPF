<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.SliderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <ScrollViewer Padding="{StaticResource GalleryPagePadding}" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Description="用于在连续或分段区间内选择一个数值。" Title="Slider 滑块" />
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="实时数值" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <zen:ZenSlider Maximum="100" TickFrequency="10" Value="{Binding Value, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ZenTextSecondaryBrush}" Text="{Binding Value, StringFormat={}{0:F0}%}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="不同范围" />
                    <Grid Margin="0,0,0,8">
                        <TextBlock Foreground="{DynamicResource ZenTextSecondaryBrush}" Text="亮度 · 0–100" />
                        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource ZenTextSecondaryBrush}" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:F0}%}" />
                    </Grid>
                    <zen:ZenSlider x:Name="BrightnessSlider" Maximum="100" Value="65" />
                    <Grid Margin="0,20,0,8">
                        <TextBlock Foreground="{DynamicResource ZenTextSecondaryBrush}" Text="字号 · 12–24，步进 2" />
                        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource ZenTextSecondaryBrush}" Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0:F0} px}" />
                    </Grid>
                    <zen:ZenSlider x:Name="FontSizeSlider" IsSnapToTickEnabled="True" Maximum="24" Minimum="12" TickFrequency="2" Value="16" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="方向与状态" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                Text="垂直音量 · 70%" />
                            <zen:ZenSlider
                                Height="140"
                                HorizontalAlignment="Center"
                                Maximum="100"
                                Orientation="Vertical"
                                Value="70" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource ZenTextSecondaryBrush}"
                                Text="禁用状态 · 35%" />
                            <zen:ZenSlider IsEnabled="False" Maximum="100" Value="35" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <gallery:PropertyTable ControlType="{x:Type zen:ZenSlider}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.DatePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="DatePicker 日期选择器" Description="支持键盘输入、日历选择、日期范围与不可选日期。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本用法与状态" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="待选择" />
                            <zen:ZenDatePicker Watermark="请选择日期" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="已选择" />
                            <zen:ZenDatePicker x:Name="SelectedDatePicker" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="仅日历选择" />
                            <zen:ZenDatePicker IsTextInputReadOnly="True" Watermark="请从日历选择" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="禁用" />
                            <zen:ZenDatePicker IsEnabled="False" Watermark="不可用" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="日期格式" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="短日期" />
                            <zen:ZenDatePicker
                                x:Name="ShortDatePicker"
                                Width="220"
                                SelectedDateFormat="Short" />
                        </StackPanel>
                        <StackPanel Width="300" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="长日期" />
                            <zen:ZenDatePicker
                                x:Name="LongDatePicker"
                                Width="300"
                                SelectedDateFormat="Long" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="日期约束" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="仅可选择今天起 30 天内的工作日；周末日期在日历中不可选。" />
                    <zen:ZenDatePicker
                        x:Name="ConstrainedDatePicker"
                        Width="260"
                        HorizontalAlignment="Left"
                        Watermark="选择未来工作日" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="日历弹层" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="通过 CalendarPopupWidth、CalendarPopupHeight 和 CalendarFontSize 调整单个日期选择器的弹层尺寸与字号。" />
                    <zen:ZenDatePicker
                        x:Name="PopupMetricsDatePicker"
                        Width="260"
                        HorizontalAlignment="Left"
                        CalendarFontSize="16"
                        CalendarPopupHeight="380"
                        CalendarPopupWidth="420"
                        Watermark="打开自定义日历" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="圆角与尺寸" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="控件尺寸、下拉按钮点击区域和日历图标可以分别调整。" />
                    <WrapPanel VerticalAlignment="Bottom">
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="紧凑 · 32px" />
                            <zen:ZenDatePicker
                                Width="200"
                                Height="32"
                                CornerRadius="0"
                                Watermark="直角" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="默认 · 36px" />
                            <zen:ZenDatePicker
                                Width="220"
                                Height="36"
                                CornerRadius="6"
                                Watermark="默认圆角" />
                        </StackPanel>
                        <StackPanel Width="240" Style="{StaticResource GalleryWrapFieldStyle}">
                            <TextBlock Style="{StaticResource GalleryFieldLabelStyle}" Text="宽松 · 自定义按钮" />
                            <zen:ZenDatePicker
                                Width="240"
                                Height="44"
                                CornerRadius="18"
                                DropDownButtonHeight="34"
                                DropDownButtonIconSize="20"
                                DropDownButtonWidth="36"
                                Watermark="36 × 34 按钮" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <gallery:PropertyTable ControlType="{x:Type zen:ZenDatePicker}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

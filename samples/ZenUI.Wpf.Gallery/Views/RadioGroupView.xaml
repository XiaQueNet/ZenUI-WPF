<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.RadioGroupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="40"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader
                Title="RadioGroup 单选组"
                Description="以按钮形式呈现一组互斥选项，适用于分类、规格和筛选场景。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="等宽描边选项" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="通过 ItemsSource 提供选项，SelectedItem 或 SelectedValue 双向绑定当前选择。" />
                    <zen:ZenRadioGroup
                        ItemsSource="{Binding Categories, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        SelectedIndex="1" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外观" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="Outlined" />
                            <zen:ZenRadioGroup
                                ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                SelectedIndex="0"
                                Spacing="8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="Filled" />
                            <zen:ZenRadioGroup
                                Appearance="Filled"
                                ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                SelectedIndex="1"
                                Spacing="8" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="布局" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="可以切换为纵向排列，并关闭等宽分配。" />
                    <zen:ZenRadioGroup
                        Width="320"
                        HorizontalAlignment="Left"
                        IsItemWidthUniform="False"
                        ItemsSource="{Binding PlanOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Orientation="Vertical"
                        SelectedIndex="1"
                        Spacing="8" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="禁用状态" />
                    <zen:ZenRadioGroup
                        IsEnabled="False"
                        ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        SelectedIndex="1" />
                </StackPanel>
            </Border>

            <gallery:PropertyTable ControlType="{x:Type zen:ZenRadioGroup}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.RadioGroupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader
                Title="RadioGroup 单选组"
                Description="以按钮形式呈现一组互斥选项，适用于分类、规格和筛选场景。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="等宽描边选项" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="通过 ItemsSource 提供选项，SelectedItem 或 SelectedValue 双向绑定当前选择。" />
                    <zen:ZenRadioGroup
                        ItemsSource="{Binding Categories, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        SelectedIndex="1" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="显示模式" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,16,24">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="Radio" />
                            <zen:ZenRadioGroup
                                Appearance="Radio"
                                ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                SelectedIndex="0"
                                Spacing="8" />
                        </StackPanel>
                        <StackPanel Margin="16,0,16,24">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="Filled" />
                            <zen:ZenRadioGroup
                                Appearance="Filled"
                                ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                SelectedIndex="1"
                                Spacing="8" />
                        </StackPanel>
                        <StackPanel Margin="16,0,0,24">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="Outlined" />
                            <zen:ZenRadioGroup
                                Appearance="Outlined"
                                ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                SelectedIndex="1"
                                Spacing="8" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="Ghost" />
                            <zen:ZenRadioGroup
                                Appearance="Ghost"
                                ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                SelectedIndex="1"
                                Spacing="8" />
                        </StackPanel>
                        <StackPanel Margin="16,0">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="Underline" />
                            <zen:ZenRadioGroup
                                Appearance="Underline"
                                ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                SelectedIndex="1"
                                Spacing="8" />
                        </StackPanel>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource GallerySupportingTextStyle}"
                                Text="Segmented" />
                            <zen:ZenRadioGroup
                                Appearance="Segmented"
                                ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                SelectedIndex="1" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="布局" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="可以切换为纵向排列，并关闭等宽分配。" />
                    <zen:ZenRadioGroup
                        Width="320"
                        HorizontalAlignment="Left"
                        IsItemSizeUniform="False"
                        ItemsSource="{Binding PlanOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Orientation="Vertical"
                        SelectedIndex="1"
                        Spacing="8" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="选中颜色" />
                    <TextBlock
                        Style="{StaticResource GallerySectionDescriptionStyle}"
                        Text="SelectionBrush 统一控制选中项的背景、边框或选择指示器。" />
                    <zen:ZenRadioGroup
                        Appearance="Filled"
                        ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        SelectedIndex="1"
                        SelectionBrush="#FFD726A3" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="禁用状态" />
                    <zen:ZenRadioGroup
                        IsEnabled="False"
                        ItemsSource="{Binding ShortOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        SelectedIndex="1" />
                </StackPanel>
            </Border>

            <gallery:PropertyTable ControlType="{x:Type zen:ZenRadioGroup}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

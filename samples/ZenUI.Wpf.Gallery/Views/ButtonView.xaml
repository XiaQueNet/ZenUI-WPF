<UserControl
    x:Class="ZenUI.Wpf.Gallery.Views.ButtonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="clr-namespace:ZenUI.Wpf.Gallery.Controls"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf">
    <UserControl.Resources>
        <Style
            x:Key="ButtonPageRowLabelStyle"
            BasedOn="{StaticResource GalleryFieldLabelStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="88" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ButtonPageIconStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type zen:ZenButton}}}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <LinearGradientBrush x:Key="RainbowButtonBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF3B30" />
            <GradientStop Offset="0.18" Color="#FF9500" />
            <GradientStop Offset="0.36" Color="#FFCC00" />
            <GradientStop Offset="0.54" Color="#34C759" />
            <GradientStop Offset="0.72" Color="#00C7BE" />
            <GradientStop Offset="0.86" Color="#007AFF" />
            <GradientStop Offset="1" Color="#AF52DE" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowButtonBorderBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#00F5FF" />
            <GradientStop Offset="0.33" Color="#A3FF12" />
            <GradientStop Offset="0.66" Color="#FFF200" />
            <GradientStop Offset="1" Color="#FF2BD6" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowButtonForegroundBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#3B0764" />
            <GradientStop Offset="0.5" Color="#172554" />
            <GradientStop Offset="1" Color="#4C0519" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowButtonHoverBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FF2BD6" />
            <GradientStop Offset="0.2" Color="#8B5CF6" />
            <GradientStop Offset="0.4" Color="#007AFF" />
            <GradientStop Offset="0.6" Color="#00E5A8" />
            <GradientStop Offset="0.8" Color="#D9FF00" />
            <GradientStop Offset="1" Color="#FF6B00" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowButtonHoverBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF1744" />
            <GradientStop Offset="0.5" Color="#7C3AED" />
            <GradientStop Offset="1" Color="#00E5FF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowButtonHoverForegroundBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#111827" />
            <GradientStop Offset="0.5" Color="#3B0764" />
            <GradientStop Offset="1" Color="#111827" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowButtonPressedBrush" StartPoint="1,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#701A75" />
            <GradientStop Offset="0.2" Color="#4338CA" />
            <GradientStop Offset="0.4" Color="#0369A1" />
            <GradientStop Offset="0.6" Color="#047857" />
            <GradientStop Offset="0.8" Color="#C2410C" />
            <GradientStop Offset="1" Color="#BE123C" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowButtonPressedBorderBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#D9FF00" />
            <GradientStop Offset="0.5" Color="#00F5FF" />
            <GradientStop Offset="1" Color="#FF2BD6" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowButtonPressedForegroundBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="0.5" Color="#FFF7A8" />
            <GradientStop Offset="1" Color="#FFFFFF" />
        </LinearGradientBrush>
        <Style
            x:Key="RainbowInteractionButtonStyle"
            BasedOn="{StaticResource ZenButtonStyle}"
            TargetType="{x:Type zen:ZenButton}">
            <Setter Property="Background" Value="{StaticResource RainbowButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RainbowButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{StaticResource RainbowButtonForegroundBrush}" />
            <Setter Property="HoverBackground" Value="{StaticResource RainbowButtonHoverBrush}" />
            <Setter Property="HoverBorderBrush" Value="{StaticResource RainbowButtonHoverBorderBrush}" />
            <Setter Property="HoverForeground" Value="{StaticResource RainbowButtonHoverForegroundBrush}" />
            <Setter Property="PressedBackground" Value="{StaticResource RainbowButtonPressedBrush}" />
            <Setter Property="PressedBorderBrush" Value="{StaticResource RainbowButtonPressedBorderBrush}" />
            <Setter Property="PressedForeground" Value="{StaticResource RainbowButtonPressedForegroundBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer
        Padding="{StaticResource GalleryPagePadding}"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <gallery:PageHeader Title="Button 按钮" Description="用于触发即时操作，支持三种外观、四种语义、丰富内容和完整交互状态。" />

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外观与语义" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="Appearance 控制表现形式，Variant 控制操作语义；两者可以自由组合。"
                        TextWrapping="Wrap" />
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource ButtonPageRowLabelStyle}"
                                Text="Filled" />
                            <WrapPanel>
                                <zen:ZenButton
                                    Content="中性按钮"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Neutral" />
                                <zen:ZenButton Content="主要按钮" Style="{StaticResource GalleryButtonStyle}" />
                                <zen:ZenButton
                                    Content="成功按钮"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Success" />
                                <zen:ZenButton
                                    Content="警告按钮"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Warning" />
                            </WrapPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource ButtonPageRowLabelStyle}"
                                Text="Outlined" />
                            <WrapPanel>
                                <zen:ZenButton
                                    Appearance="Outlined"
                                    Content="中性按钮"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Neutral" />
                                <zen:ZenButton
                                    Appearance="Outlined"
                                    Content="主要按钮"
                                    Style="{StaticResource GalleryButtonStyle}" />
                                <zen:ZenButton
                                    Appearance="Outlined"
                                    Content="成功按钮"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Success" />
                                <zen:ZenButton
                                    Appearance="Outlined"
                                    Content="警告按钮"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Warning" />
                            </WrapPanel>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Left"
                                Style="{StaticResource ButtonPageRowLabelStyle}"
                                Text="Text" />
                            <WrapPanel>
                                <zen:ZenButton
                                    Appearance="Text"
                                    Content="中性按钮"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Neutral" />
                                <zen:ZenButton
                                    Appearance="Text"
                                    Content="主要按钮"
                                    Style="{StaticResource GalleryButtonStyle}" />
                                <zen:ZenButton
                                    Appearance="Text"
                                    Content="成功按钮"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Success" />
                                <zen:ZenButton
                                    Appearance="Text"
                                    Content="警告按钮"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Warning" />
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="尺寸与内容" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="通过 Height、Padding 和 FontSize 组合尺寸；Content 可承载文字、图标或任意 WPF 内容。" />
                    <DockPanel Margin="0,0,0,18">
                        <TextBlock
                            DockPanel.Dock="Left"
                            Style="{StaticResource ButtonPageRowLabelStyle}"
                            Text="尺寸" />
                        <WrapPanel VerticalAlignment="Center">
                            <zen:ZenButton
                                Height="30"
                                MinHeight="0"
                                MinWidth="72"
                                Margin="0,0,12,0"
                                Padding="12,0"
                                Content="紧凑"
                                FontSize="12" />
                            <zen:ZenButton Content="默认" Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Height="44"
                                MinWidth="108"
                                Margin="0,0,12,0"
                                Padding="20,0"
                                Content="宽松"
                                FontSize="15" />
                        </WrapPanel>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Left"
                            Style="{StaticResource ButtonPageRowLabelStyle}"
                            Text="丰富内容" />
                        <WrapPanel>
                            <zen:ZenButton Style="{StaticResource GalleryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,7 L5.2,10.2 L12,3.4" Style="{StaticResource ButtonPageIconStyle}" />
                                    <TextBlock Margin="7,0,0,0" Text="保存更改" />
                                </StackPanel>
                            </zen:ZenButton>
                            <zen:ZenButton Appearance="Outlined" Style="{StaticResource GalleryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,7,0" Text="继续" />
                                    <Path Data="M3,2 L9,7 L3,12 M2,7 L9,7" Style="{StaticResource ButtonPageIconStyle}" />
                                </StackPanel>
                            </zen:ZenButton>
                            <zen:ZenButton
                                Width="36"
                                Height="36"
                                Margin="0,0,12,0"
                                Padding="10"
                                Appearance="Text"
                                AutomationProperties.Name="刷新"
                                ToolTip="刷新">
                                <Path Data="M11.5,4.5 A5,5 0 1 0 12,9 M11.5,1.8 L11.5,4.8 L8.5,4.8" Style="{StaticResource ButtonPageIconStyle}" />
                            </zen:ZenButton>
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="按钮状态" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="将鼠标移到可用按钮上并按下，可以查看 Hover 和 Pressed 状态。"
                        TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock
                            DockPanel.Dock="Left"
                            Style="{StaticResource ButtonPageRowLabelStyle}"
                            Text="可用" />
                        <WrapPanel>
                            <zen:ZenButton Content="填充按钮" Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Appearance="Outlined"
                                Content="描边按钮"
                                Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Appearance="Text"
                                Content="文本按钮"
                                Style="{StaticResource GalleryButtonStyle}" />
                        </WrapPanel>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Left"
                            Style="{StaticResource ButtonPageRowLabelStyle}"
                            Text="禁用" />
                        <WrapPanel>
                            <zen:ZenButton
                                Content="填充按钮"
                                IsEnabled="False"
                                Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Appearance="Outlined"
                                Content="描边按钮"
                                IsEnabled="False"
                                Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Appearance="Text"
                                Content="文本按钮"
                                IsEnabled="False"
                                Style="{StaticResource GalleryButtonStyle}" />
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="实际操作组合" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="一个区域通常只保留一个主要操作，次要操作使用 Outlined 或 Text 降低视觉层级。" />
                    <Border
                        Padding="18"
                        Background="{DynamicResource ZenSurfaceMutedBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="发布当前版本" />
                                <TextBlock
                                    Margin="0,5,24,0"
                                    Style="{StaticResource GallerySupportingTextStyle}"
                                    Text="发布后，所有使用者都能立即获得最新内容。" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <zen:ZenButton
                                    Appearance="Text"
                                    Content="取消"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Neutral" />
                                <zen:ZenButton
                                    Appearance="Outlined"
                                    Content="保存草稿"
                                    Style="{StaticResource GalleryButtonStyle}"
                                    Variant="Neutral" />
                                <zen:ZenButton Content="立即发布" Style="{StaticResource GalleryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <zen:ZenButton
                        Height="40"
                        Margin="0,16,0,0"
                        HorizontalContentAlignment="Center"
                        Content="创建新项目（通栏操作）" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="圆角定制" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="CornerRadius 支持统一圆角和四角独立设置；胶囊按钮的圆角等于按钮高度的一半。"
                        TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock
                            DockPanel.Dock="Left"
                            Style="{StaticResource ButtonPageRowLabelStyle}"
                            Text="统一圆角" />
                        <WrapPanel>
                            <zen:ZenButton
                                Content="直角 0"
                                CornerRadius="0"
                                Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Content="小圆角 4"
                                CornerRadius="4"
                                Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Content="默认 10"
                                CornerRadius="10"
                                Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Content="胶囊 18"
                                CornerRadius="18"
                                Style="{StaticResource GalleryButtonStyle}" />
                        </WrapPanel>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Left"
                            Style="{StaticResource ButtonPageRowLabelStyle}"
                            Text="独立四角" />
                        <WrapPanel>
                            <zen:ZenButton
                                Appearance="Outlined"
                                Content="左侧圆角"
                                CornerRadius="18,0,0,18"
                                Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Appearance="Outlined"
                                Content="右侧圆角"
                                CornerRadius="0,18,18,0"
                                Style="{StaticResource GalleryButtonStyle}" />
                            <zen:ZenButton
                                Appearance="Outlined"
                                Content="对角圆角"
                                CornerRadius="18,0,18,0"
                                Style="{StaticResource GalleryButtonStyle}" />
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="交互颜色定制" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource GallerySupportingTextStyle}"
                        Text="背景、文字和边框都可分别覆盖 Hover 与 Pressed 状态色；未设置的状态继续使用主题默认值。" />
                    <zen:ZenButton
                        Width="168"
                        Height="40"
                        HorizontalAlignment="Left"
                        Appearance="Outlined"
                        Content="🌈 自定义交互颜色"
                        FontWeight="SemiBold"
                        Style="{StaticResource RainbowInteractionButtonStyle}" />
                </StackPanel>
            </Border>

            <gallery:PropertyTable ControlType="{x:Type zen:ZenButton}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

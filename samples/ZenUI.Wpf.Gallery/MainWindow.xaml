<Window
    x:Class="ZenUI.Wpf.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="clr-namespace:ZenUI.Wpf.Gallery.Navigation"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf"
    Title="ZenUI Controls Gallery"
    Width="1280"
    Height="800"
    MinWidth="1024"
    MinHeight="640"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource ZenSurfaceBrush}"
    FontFamily="Microsoft YaHei UI"
    Foreground="{DynamicResource ZenTextPrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style
            x:Key="NavigationGroupExpanderStyle"
            BasedOn="{StaticResource ZenExpanderStyle}"
            TargetType="{x:Type zen:ZenExpander}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HeaderPadding" Value="12,7" />
            <Setter Property="Padding" Value="0,2,0,6" />
            <Setter Property="GlyphSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBodySmall}" />
            <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
        </Style>

        <Style
            x:Key="NavigationRadioItemStyle"
            BasedOn="{StaticResource ZenRadioItemOutlineStyle}"
            TargetType="{x:Type zen:ZenRadioItem}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Background="{DynamicResource ZenSurfaceBrush}"
            BorderBrush="{DynamicResource ZenDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    BorderBrush="{DynamicResource ZenDividerBrush}"
                    BorderThickness="0,0,1,0">
                    <StackPanel
                        Margin="24,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="{DynamicResource ZenFontSizeTitle}"
                            FontWeight="{DynamicResource ZenFontWeightSemibold}"
                            Foreground="{DynamicResource ZenTextPrimaryBrush}"
                            Text="ZenUI" />
                        <TextBlock
                            Margin="10,4,0,0"
                            FontSize="{DynamicResource ZenFontSizeCaption}"
                            Foreground="{DynamicResource ZenTextSecondaryBrush}"
                            Text="Controls Gallery" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="24,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource ZenFontSizeCaption}"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="主题" />
                    <zen:ZenComboBox
                        Width="120"
                        Height="34"
                        AutomationProperties.Name="界面主题"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}">
                        <zen:ZenComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </zen:ZenComboBox.ItemTemplate>
                    </zen:ZenComboBox>

                    <TextBlock
                        Margin="20,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource ZenFontSizeCaption}"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="密度" />
                    <zen:ZenComboBox
                        Width="104"
                        Height="34"
                        AutomationProperties.Name="界面密度"
                        ItemsSource="{Binding DensityOptions}"
                        SelectedItem="{Binding SelectedDensityOption, Mode=TwoWay}">
                        <zen:ZenComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </zen:ZenComboBox.ItemTemplate>
                    </zen:ZenComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{DynamicResource ZenSurfaceMutedBrush}"
                BorderBrush="{DynamicResource ZenDividerBrush}"
                BorderThickness="0,0,1,0">
                <ScrollViewer
                    Margin="0,12,0,12"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="12,0,10,0" ItemsSource="{Binding NavigationGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <zen:ZenExpander
                                    Header="{Binding Title}"
                                    IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                    Style="{StaticResource NavigationGroupExpanderStyle}">
                                    <zen:ZenRadioGroup
                                        AutomationProperties.Name="{Binding Title}"
                                        IsItemWidthUniform="False"
                                        ItemContainerStyle="{StaticResource NavigationRadioItemStyle}"
                                        ItemsSource="{Binding Items}"
                                        Orientation="Vertical"
                                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                        Spacing="2">
                                        <zen:ZenRadioGroup.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    ToolTip="{Binding DisplayName}">
                                                    <TextBlock
                                                        FontSize="{DynamicResource ZenFontSizeBody}"
                                                        Text="{Binding ControlName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="{DynamicResource ZenFontSizeCaption}"
                                                        Text="{Binding ChineseName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </zen:ZenRadioGroup.ItemTemplate>
                                    </zen:ZenRadioGroup>
                                </zen:ZenExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ContentControl Grid.Column="1" prism:RegionManager.RegionName="{x:Static navigation:RegionNames.ContentRegion}" />
        </Grid>
    </Grid>
</Window>

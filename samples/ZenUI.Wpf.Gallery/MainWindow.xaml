<Window
    x:Class="ZenUI.Wpf.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="clr-namespace:ZenUI.Wpf.Gallery.Navigation"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:zen="https://zenui.mnorg.cn/xaml/wpf"
    Title="ZenUI Controls Gallery"
    Width="1280"
    Height="800"
    MinWidth="1024"
    MinHeight="640"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource ZenSurfaceMutedBrush}"
    FontFamily="Microsoft YaHei UI"
    Foreground="{DynamicResource ZenTextPrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style
            x:Key="NavigationGroupExpanderStyle"
            BasedOn="{StaticResource ZenExpanderStyle}"
            TargetType="{x:Type zen:ZenExpander}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HeaderPadding" Value="12,8" />
            <Setter Property="GlyphSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBodySmall}" />
            <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
        </Style>

        <Style
            x:Key="NavigationRadioItemStyle"
            BasedOn="{StaticResource ZenRadioItemStyle}"
            TargetType="{x:Type zen:ZenRadioItem}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0,12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ZenTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource ZenFontSizeBody}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Background="{DynamicResource ZenSurfaceMutedBrush}"
            BorderBrush="{DynamicResource ZenDividerBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="24,28,24,4">
                    <TextBlock
                        FontSize="23"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ZenTextPrimaryBrush}"
                        Text="ZenUI" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="Controls Gallery" />
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,12,0,8"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="16,0,12,0" ItemsSource="{Binding NavigationGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <zen:ZenExpander
                                    Header="{Binding Title}"
                                    IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                    Style="{StaticResource NavigationGroupExpanderStyle}">
                                    <zen:ZenRadioGroup
                                        Margin="0,0,0,6"
                                        AutomationProperties.Name="{Binding Title}"
                                        DisplayMemberPath="DisplayName"
                                        IsItemWidthUniform="False"
                                        ItemContainerStyle="{StaticResource NavigationRadioItemStyle}"
                                        ItemsSource="{Binding Items}"
                                        Orientation="Vertical"
                                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                        Spacing="2" />
                                </zen:ZenExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="24,8,24,24">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="界面主题" />
                    <zen:ZenComboBox
                        Height="34"
                        AutomationProperties.Name="界面主题"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}">
                        <zen:ZenComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </zen:ZenComboBox.ItemTemplate>
                    </zen:ZenComboBox>
                    <TextBlock
                        Margin="0,12,0,8"
                        FontSize="{DynamicResource ZenFontSizeCaption}"
                        Foreground="{DynamicResource ZenTextSecondaryBrush}"
                        Text="界面密度" />
                    <zen:ZenComboBox
                        Height="34"
                        AutomationProperties.Name="界面密度"
                        ItemsSource="{Binding DensityOptions}"
                        SelectedItem="{Binding SelectedDensityOption, Mode=TwoWay}">
                        <zen:ZenComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </zen:ZenComboBox.ItemTemplate>
                    </zen:ZenComboBox>
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource ZenTextPlaceholderBrush}"
                        Text="ZenUI.Wpf · Controls Gallery" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="{x:Static navigation:RegionNames.ContentRegion}" />
    </Grid>
</Window>
